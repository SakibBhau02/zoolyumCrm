# Copy to .env before running docker compose (docker reads this file automatically).
# Only the containers need these; the local dev servers read apps/api/.env.
# `npm run setup` creates this file for you with generated secrets.

# Required by the `app` profile (docker compose --profile app up).
JWT_SECRET=replace-with-a-long-random-secret

# Required by the `web` image build (baked into the browser bundle).
# For local docker runs use http://localhost:4000/api
# For a public deploy use https://api.your-domain.com/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Optional overrides for the app profile
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=0
