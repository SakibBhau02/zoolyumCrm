model InsightSettings {
  id             String   @id @default("default")
  reportDefaults Json     @default("{\"metrics\": [\"spend\", \"ctr\", \"roas\"], \"currency\": \"BDT\", \"timezone\": \"Asia/Dhaka\", \"datePreset\": \"30d\", \"dimensions\": [\"date\"], \"comparePreset\": \"prev_period\"}")
  syncConfig     Json     @default("{\"interval\": \"6h\", \"backfillDays\": 30, \"retentionDays\": 365}")
  alertDefaults  Json     @default("{\"cplLimit\": 400, \"ctrDropPct\": 30, \"windowDays\": 7, \"spendSpikeX\": 2, \"dedupMinutes\": 30}")
  branding       Json     @default("{\"template\": \"executive\", \"includeCharts\": true}")
  automation     Json     @default("{\"format\": \"pdf\", \"defaultCron\": \"daily\", \"defaultRecipients\": []}")
  exportConfig   Json     @default("{\"locale\": \"en-BD\", \"defaultFormat\": \"pdf\", \"includeCharts\": true}")
  updatedAt      DateTime @updatedAt
  updatedById    String?
}

model PortalUser {
  id                   String                @id @default(cuid())
  clientContactId      String                @unique
  userId               String?               @unique
  passwordHash         String
  lastLoginAt          DateTime?
  isActive             Boolean               @default(true)
  /// Bumped on password reset / force-logout; tokens carry the previous value.
  tokenVersion         Int                   @default(0)
  createdAt            DateTime              @default(now())
  telegramChatId       String?               @unique
  telegramLinkCode     String?
  telegramLinkCreatedAt DateTime?
  telegramLinkedAt     DateTime?
  clientComments       ClientComment[]
  deliverableApprovals DeliverableApproval[]
  activities           PortalActivityLog[]
  contactAccess        PortalContactAccess?
  threadReads          PortalThreadRead[]
  notifications        Notification[]
  clientContact        ClientContact         @relation(fields: [clientContactId], references: [id], onDelete: Cascade)
  user                 User?                 @relation("PortalUserAccount", fields: [userId], references: [id])
}

/// Per-contact portal permissions. Absent row = full access to the client account.
model PortalContactAccess {
  id             String      @id @default(cuid())
  portalUserId   String      @unique
  scope          PortalScope @default(ALL)
  /// Only used when scope = CUSTOM.
  projectIds     String[]    @default([])
  /// Which portal tabs this contact may open. An empty list denies every module.
  modules        String[]    @default([])
  canSeeAdSpend  Boolean     @default(false)
  updatedAt      DateTime    @updatedAt
  portalUser     PortalUser  @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
}

/// Last-read marker per portal user per conversation thread.
model PortalThreadRead {
  id           String     @id @default(cuid())
  portalUserId String
  threadKey    String
  lastReadAt   DateTime   @default(now())
  portalUser   PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@unique([portalUserId, threadKey])
  @@index([threadKey])
}

model PortalActivityLog {
  id                String       @id @default(cuid())
  portalUserId      String
  action            PortalAction
  relatedEntityType String?
  relatedEntityId   String?
  timestamp         DateTime     @default(now())
  portalUser        PortalUser   @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@index([timestamp])
  @@index([portalUserId])
}

model ClientComment {
  id            String           @id @default(cuid())
  /// Owning client — required for the general thread, where projectId is null.
  clientId      String?
  /// Null for the client-level "general" thread.
  projectId     String?
  /// "general" or the project id — lets both thread kinds be queried uniformly.
  threadKey     String           @default("general")
  parentId      String?
  portalUserId  String?
  authorId      String?
  content       String
  attachmentUrl String?
  sentiment     CommentSentiment @default(NEUTRAL)
  createdAt     DateTime         @default(now())
  author        User?            @relation(fields: [authorId], references: [id])
  portalUser    PortalUser?      @relation(fields: [portalUserId], references: [id])
  client        Client?          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project       Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent        ClientComment?   @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies       ClientComment[]  @relation("CommentThread")

  @@index([projectId])
  @@index([createdAt])
  @@index([threadKey, createdAt])
  @@index([clientId, threadKey, createdAt])
  @@index([parentId])
}

model DeliverableApproval {
  id            String           @id @default(cuid())
  projectFileId String
  portalUserId  String
  decision      ApprovalDecision
  revisionNotes String?
  decidedAt     DateTime         @default(now())
  portalUser    PortalUser       @relation(fields: [portalUserId], references: [id])

  @@unique([projectFileId, portalUserId])
  @@index([decidedAt])
  @@index([projectFileId])
}

