  taskId     String
  employeeId String?
  startedAt  DateTime  @default(now())
  stoppedAt  DateTime?
  notes      String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([employeeId, stoppedAt])
}

model Sprint {
  id            String                @id @default(cuid())
  name          String
  goal          String?
  projectId     String?
  startDate     DateTime
  endDate       DateTime
