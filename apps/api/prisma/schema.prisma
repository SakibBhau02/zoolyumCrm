  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User?    @relation("SavedCalendarViewOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model CalendarShareLink {
  id          String    @id @default(cuid())
  clientId    String?
  planId      String?
  token       String    @unique
  scope       String    @default("PLAN")
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model TaskTemplate {
  id                    String   @id @default(cuid())
  name                  String
  description           String?
  defaultTasks          Json     @default("[]")
  createdAt             DateTime @default(now())
  category              String?
  benchmarkDurationDays Int?
  benchmarkHours        Decimal? @db.Decimal(8, 2)
}

model AutomationRule {
  id        String   @id @default(cuid())
  name      String
  trigger   String
  action    String
  config    Json     @default("{}")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ReportDefinition {
  id               String            @id @default(cuid())
  name             String
  createdById      String?
  metrics          Json?             @default("[]")
  dimensions       Json?             @default("[]")
  filters          Json?             @default("{}")
  schedule         String?
  lastRunAt        DateTime?
  createdAt        DateTime          @default(now())
  clientId         String?
  isCrossPlatform  Boolean           @default(false)
  provider         AdsProvider?
  reportType       String            @default("CUSTOM")
  taskId           String?
  client           Client?           @relation(fields: [clientId], references: [id])
  createdBy        User?             @relation(fields: [createdById], references: [id])
  task             Task?             @relation(fields: [taskId], references: [id])
  runs             ReportRun[]
  scheduledReports ScheduledReport[]

  @@index([createdAt])
  @@index([clientId])
  @@index([reportType])
}

model CorrelationInsight {
  id              String    @id @default(cuid())
  description     String
  supportingData  Json?     @default("{}")
  confidenceLevel Float?
  surfacedAt      DateTime  @default(now())
  dismissedById   String?
  dismissedAt     DateTime?
  dismissedBy     User?     @relation(fields: [dismissedById], references: [id])

  @@index([surfacedAt])
}

model ExecutiveDigestLog {
  id             String   @id @default(cuid())
  period         String
  generatedAt    DateTime @default(now())
  snapshotData   Json?    @default("{}")
  deliveryStatus String   @default("SENT")

  @@index([generatedAt])
}

model MetricSnapshot {
  id         String   @id @default(cuid())
  metricName String
  scope      String   @default("COMPANY")
  scopeId    String?
  value      Float
  recordedAt DateTime @default(now())

  @@index([metricName, recordedAt])
}

model AdAccount {
  id             String            @id @default(cuid())
  clientId       String?
  provider       AdsProvider
  externalId     String
  name           String
  status         IntegrationStatus @default(CONNECTED)
  credentialsEnc String?
  lastSyncAt     DateTime?
  createdAt      DateTime          @default(now())
  client         Client?           @relation(fields: [clientId], references: [id])
  campaigns      AdCampaign[]
  adInsights     AdInsight[]
  syncLogs       AdSyncLog[]

  @@unique([provider, externalId])
  @@index([clientId])
  @@index([provider])
}

model AdCampaign {
  id          String      @id @default(cuid())
  adAccountId String
  externalId  String
  name        String
  status      String      @default("ENABLED")
  budget      Decimal?    @db.Decimal(14, 2)
  objective   String?
  adAccount   AdAccount   @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  insights    AdInsight[]
  adSets      AdSet[]

  @@unique([adAccountId, externalId])
  @@index([adAccountId])
}

model AdSet {
  id         String      @id @default(cuid())
  campaignId String
  externalId String
  name       String
  status     String      @default("ACTIVE")
  ads        Ad[]
  insights   AdInsight[]
  campaign   AdCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, externalId])
  @@index([campaignId])
}

model Ad {
  id           String      @id @default(cuid())
  adSetId      String
  externalId   String
  name         String
  status       String      @default("ACTIVE")
  creativeUrl  String?
  creativeType String?
  adSet        AdSet       @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  insights     AdInsight[]

  @@unique([adSetId, externalId])
  @@index([adSetId])
}

model AdInsight {
  id              String      @id @default(cuid())
  provider        AdsProvider
  date            DateTime    @db.Date
  campaignId      String?
  adSetId         String?
  adId            String?
  adAccountId     String
  clientId        String?
  impressions     Int         @default(0)
  clicks          Int         @default(0)
  spend           Decimal     @default(0) @db.Decimal(14, 2)
  conversions     Int         @default(0)
  conversionValue Decimal?    @db.Decimal(14, 2)
  reach           Int?
  frequency       Float?
  ctr             Float?
  cpc             Decimal?    @db.Decimal(10, 4)
  cpm             Decimal?    @db.Decimal(10, 4)
  cpa             Decimal?    @db.Decimal(10, 4)
  roas            Float?
  qualityScore    Int?
  engagement      Int?
  videoViews      Json?
  demographic     Json?
  createdAt       DateTime    @default(now())
  adAccount       AdAccount   @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  ad              Ad?         @relation(fields: [adId], references: [id], onDelete: Cascade)
  adSet           AdSet?      @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  campaign        AdCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  client          Client?     @relation(fields: [clientId], references: [id])

  @@unique([provider, date, campaignId, adSetId, adId])
  @@index([date, provider])
  @@index([clientId, date])
  @@index([campaignId, date])
  @@index([adAccountId, date])
}

model AdSyncLog {
  id            String       @id @default(cuid())
  adAccountId   String
  startedAt     DateTime     @default(now())
  finishedAt    DateTime?
  status        AdSyncStatus @default(PENDING)
  recordsPulled Int          @default(0)
  error         String?
  adAccount     AdAccount    @relation(fields: [adAccountId], references: [id], onDelete: Cascade)

  @@index([adAccountId, startedAt])
}

model ScheduledReport {
  id          String           @id @default(cuid())
  reportDefId String
  cron        String
  recipients  Json             @default("[]")
  isActive    Boolean          @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime         @default(now())
  reportDef   ReportDefinition @relation(fields: [reportDefId], references: [id], onDelete: Cascade)

  @@index([reportDefId])
}

model AlertRule {
  id              String    @id @default(cuid())
  name            String
  clientId        String?
  metric          String
  condition       String
  threshold       Float
  windowDays      Int       @default(7)
  isActive        Boolean   @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())
  client          Client?   @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([metric])
}

model ReportRun {
  id             String           @id @default(cuid())
  reportDefId    String
  ranAt          DateTime         @default(now())
  params         Json             @default("{}")
  resultSnapshot Json             @default("{}")
  fileUrl        String?
  reportDef      ReportDefinition @relation(fields: [reportDefId], references: [id], onDelete: Cascade)

  @@index([reportDefId, ranAt])
}

model InsightSettings {
  id             String   @id @default("default")
  reportDefaults Json     @default("{\"metrics\": [\"spend\", \"ctr\", \"roas\"], \"currency\": \"BDT\", \"timezone\": \"Asia/Dhaka\", \"datePreset\": \"30d\", \"dimensions\": [\"date\"], \"comparePreset\": \"prev_period\"}")
  syncConfig     Json     @default("{\"interval\": \"6h\", \"backfillDays\": 30, \"retentionDays\": 365}")
  alertDefaults  Json     @default("{\"cplLimit\": 400, \"ctrDropPct\": 30, \"windowDays\": 7, \"spendSpikeX\": 2, \"dedupMinutes\": 30}")
  branding       Json     @default("{\"template\": \"executive\", \"includeCharts\": true}")
  automation     Json     @default("{\"format\": \"pdf\", \"defaultCron\": \"daily\", \"defaultRecipients\": []}")
  exportConfig   Json     @default("{\"locale\": \"en-BD\", \"defaultFormat\": \"pdf\", \"includeCharts\": true}")
  updatedAt      DateTime @updatedAt
  updatedById    String?
}

model PortalUser {
  id                    String                @id @default(cuid())
  clientContactId       String                @unique
  userId                String?               @unique
  passwordHash          String
  lastLoginAt           DateTime?
  isActive              Boolean               @default(true)
  /// Bumped on password reset / force-logout; tokens carry the previous value.
  tokenVersion          Int                   @default(0)
  createdAt             DateTime              @default(now())
  telegramChatId        String?               @unique
  telegramLinkCode      String?
  telegramLinkCreatedAt DateTime?
  telegramLinkedAt      DateTime?
  clientComments        ClientComment[]
  deliverableApprovals  DeliverableApproval[]
  activities            PortalActivityLog[]
  contactAccess         PortalContactAccess?
  threadReads           PortalThreadRead[]
  notifications         Notification[]
  clientContact         ClientContact         @relation(fields: [clientContactId], references: [id], onDelete: Cascade)
  user                  User?                 @relation("PortalUserAccount", fields: [userId], references: [id])
}

/// Per-contact portal permissions. Absent row = full access to the client account.
model PortalContactAccess {
  id            String      @id @default(cuid())
  portalUserId  String      @unique
  scope         PortalScope @default(ALL)
  /// Only used when scope = CUSTOM.
  projectIds    String[]    @default([])
  /// Which portal tabs this contact may open. An empty list denies every module.
  modules       String[]    @default([])
  canSeeAdSpend Boolean     @default(false)
  updatedAt     DateTime    @updatedAt
  portalUser    PortalUser  @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
}

/// Last-read marker per portal user per conversation thread.
model PortalThreadRead {
  id           String     @id @default(cuid())
  portalUserId String
  threadKey    String
  lastReadAt   DateTime   @default(now())
  portalUser   PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@unique([portalUserId, threadKey])
  @@index([threadKey])
}

model PortalActivityLog {
  id                String       @id @default(cuid())
  portalUserId      String
  action            PortalAction
  relatedEntityType String?
  relatedEntityId   String?
  timestamp         DateTime     @default(now())
  portalUser        PortalUser   @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@index([timestamp])
  @@index([portalUserId])
}

model ClientComment {
  id            String           @id @default(cuid())
  /// Owning client — required for the general thread, where projectId is null.
  clientId      String?
  /// Null for the client-level "general" thread.
  projectId     String?
  /// "general" or the project id — lets both thread kinds be queried uniformly.
  threadKey     String           @default("general")
  parentId      String?
  portalUserId  String?
  authorId      String?
  content       String
  attachmentUrl String?
  sentiment     CommentSentiment @default(NEUTRAL)
  createdAt     DateTime         @default(now())
  author        User?            @relation(fields: [authorId], references: [id])
  portalUser    PortalUser?      @relation(fields: [portalUserId], references: [id])
  client        Client?          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project       Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent        ClientComment?   @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies       ClientComment[]  @relation("CommentThread")

  @@index([projectId])
  @@index([createdAt])
  @@index([threadKey, createdAt])
  @@index([clientId, threadKey, createdAt])
  @@index([parentId])
}

model DeliverableApproval {
  id            String           @id @default(cuid())
  projectFileId String
  portalUserId  String
  decision      ApprovalDecision
  revisionNotes String?
  decidedAt     DateTime         @default(now())
  portalUser    PortalUser       @relation(fields: [portalUserId], references: [id])

  @@unique([projectFileId, portalUserId])
  @@index([decidedAt])
  @@index([projectFileId])
}

