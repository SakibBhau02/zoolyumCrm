generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id                String   @id @default(cuid())
  name              String   @unique
  description       String?
  modulePermissions Json
  createdAt         DateTime @default(now())
  users             User[]
}

model User {
  id                           String                   @id @default(cuid())
  name                         String
  email                        String                   @unique
  passwordHash                 String
  roleId                       String
  employeeId                   String?                  @unique
  isActive                     Boolean                  @default(true)
  createdAt                    DateTime                 @default(now())
  lastLoginAt                  DateTime?
  attendanceCorrections        Attendance[]
  attendanceCorrectionLogs     AttendanceCorrection[]
  clients                      Client[]
  clientComments               ClientComment[]
  clientDocuments              ClientDocument[]
  dismissedCorrelationInsights CorrelationInsight[]
  creditNotes                  CreditNote[]
  approvedExpenses             Expense[]                @relation("ExpenseApproved")
  submittedExpenses            Expense[]                @relation("ExpenseSubmitted")
  financeAuditLogs             FinanceAuditLog[]
  integrations                 Integration[]
  invoices                     Invoice[]
  journalEntries               JournalEntry[]
  leads                        Lead[]
  leadActivities               LeadActivity[]
  leadAttachments              LeadAttachment[]
  leadMeetings                 LeadMeeting[]
  leadNotes                    LeadNote[]
  leaveApprovals               LeaveRequest[]           @relation("LeaveApproval")
  manualIncome                 ManualIncome[]
  notifications                Notification[]
  notificationPreferences      NotificationPreference[]
  checklistItems               EmployeeChecklistItem[]
  telegramLink                 TelegramLink?
  webauthnCredentials          WebAuthnCredential[]
  payments                     Payment[]
  performanceReviews           PerformanceReview[]
  portalUsers                  PortalUser?              @relation("PortalUserAccount")
  projects                     Project[]
  projectFiles                 ProjectFile[]
  projectReferences            ProjectReference[]
  generatedReports             ProjectReport[]          @relation("ReportGeneratedBy")
  reportDefinitions            ReportDefinition[]
  savedTaskViews               SavedTaskView[]
  taskComments                 TaskComment[]
  employee                     Employee?                @relation(fields: [employeeId], references: [id])
  role                         Role                     @relation(fields: [roleId], references: [id])
  workdayOverrides             WorkdayOverride[]
  /// Bumped on password change / deactivate / role change so old JWTs stop working.
  tokenVersion                 Int                      @default(0)
  lastLoginIp                  String?
}

/// WebAuthn platform credential (Windows Hello / Touch ID / fingerprint).
/// Used for passwordless staff sign-in and biometric clock in/out.
model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String?
  deviceLabel  String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Integration {
  id             String            @id @default(cuid())
  providerName   String
  type           IntegrationType
  status         IntegrationStatus @default(DISCONNECTED)
  credentialsEnc String?
  connectedById  String?
  connectedAt    DateTime?
  createdAt      DateTime          @default(now())
  connectedBy    User?             @relation(fields: [connectedById], references: [id])
}

/// Telegram bot channel. One row per user/employee that has pressed /start
/// with a valid link code — `chatId` is what the Bot API needs to deliver.
model TelegramLink {
  id         String    @id @default(cuid())
  userId     String?   @unique
  employeeId String?   @unique
  chatId     String    @unique
  username   String?
  firstName  String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([isActive])
}

/// Short-lived one-time code printed in the UI and consumed by `/start <code>`.
/// Codes are single-use (`usedAt`) and expire so a leaked link cannot be replayed.
model TelegramLinkCode {
  code       String    @id
  userId     String?
  employeeId String?
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
}

/// Delivery audit — mirrors WhatsappMessageLog so the Control panel can show
/// what was sent, to whom, and exactly why a send failed.
model TelegramMessageLog {
  id        String   @id @default(cuid())
  chatId    String
  kind      String   @default("notification")
  title     String?
  body      String?
  status    String   @default("queued")
  messageId String?
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

/// Onboarding / offboarding run for one employee. Items are rows (not a JSON
/// blob) so progress, ownership and "who ticked it" stay queryable and the
/// weekly nudge can find stale steps without parsing JSON.
model EmployeeChecklist {
  id          String                  @id @default(cuid())
  employeeId  String
  kind        String                  @default("ONBOARDING") // ONBOARDING | OFFBOARDING
  status      String                  @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED
  dueDate     DateTime?
  startedAt   DateTime                @default(now())
  completedAt DateTime?
  notes       String?
  employee    Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  items       EmployeeChecklistItem[]

  @@unique([employeeId, kind])
  @@index([status])
}

model EmployeeChecklistItem {
  id          String            @id @default(cuid())
  checklistId String
  label       String
  owner       String?           // HR | IT | Manager | Finance
  done        Boolean           @default(false)
  doneAt      DateTime?
  doneById    String?
  sortOrder   Int               @default(0)
  checklist   EmployeeChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  doneBy      User?             @relation(fields: [doneById], references: [id])

  @@index([checklistId, sortOrder])
}

/// Company asset register — laptops, cameras, phones, licences.
model Asset {
  id           String    @id @default(cuid())
  tag          String    @unique
  name         String
  category     String    @default("Laptop")
  serialNumber String?
  status       String    @default("AVAILABLE") // AVAILABLE | ASSIGNED | REPAIR | RETIRED
  assignedToId String?
  assignedAt   DateTime?
  purchaseDate DateTime?
  value        Decimal?  @db.Decimal(14, 2)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  assignedTo   Employee? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([assignedToId])
}

model WhatsappMessageLog {
  id                String   @id @default(cuid())
  to                String
  templateName      String?
  language          String?  @default("en")
  messageType       String   @default("template")
  params            Json?
  relatedInvoiceId  String?
  relatedEntityType String?
  relatedEntityId   String?
  status            String   @default("queued")
  wamid             String?  @unique
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([relatedInvoiceId])
  @@index([status])
  @@index([createdAt])
}

model WhatsappTemplate {
  id          String   @id @default(cuid())
  name        String
  language    String   @default("en")
  category    String   @default("UTILITY")
  description String?
  variables   String[] @default([])
  bodyPreview String?
  buttons     Json?
  isActive    Boolean  @default(true)
  metaStatus  String?

  @@unique([name, language])
}

model BrandingConfig {
  id                     String   @id @default(cuid())
  logoUrl                String?
  primaryColor           String?
  secondaryColor         String?
  invoiceNumberingFormat String   @default("ZLM-{year}-{seq}")
  updatedAt              DateTime @updatedAt
  appName                String?  @default("Zoolyum OS")
  logoDarkUrl            String?
  logoLightUrl           String?
  address                String?
  authorizedSignerName   String?
  authorizedSignerTitle  String?
  city                   String?
  country                String?
  defaultCurrency        String?  @default("BDT")
  defaultNotes           String?
  defaultPaymentDetails  Json?
  defaultTerms           String?
  email                  String?
  phone                  String?
  signatureImageUrl      String?
  tagline                String?
  taxId                  String?
  website                String?
}

model SystemAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  beforeValue Json?
  afterValue  Json?
  timestamp   DateTime @default(now())
}

model Notification {
  id           String      @id @default(cuid())
  // Exactly one of userId / portalUserId is set: staff inbox vs client portal inbox.
  userId       String?
  portalUserId String?
  type         String
  title        String
  message      String
  isRead       Boolean     @default(false)
  link         String?
  createdAt    DateTime    @default(now())
  user         User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  portalUser   PortalUser? @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([portalUserId, isRead])
  @@index([portalUserId, createdAt])
}

model NotificationPreference {
  id      String  @id @default(cuid())
  userId  String
  type    String
  channel String
  enabled Boolean @default(true)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, channel])
}

model Settings {
  id                 String   @id @default("default")
  companyProfile     Json     @default("{}")
  regional           Json     @default("{}")
  invoiceTemplate    Json     @default("{}")
  financeConfig      Json     @default("{}")
  pipelineStages     Json     @default("[]")
  leadCategories     Json     @default("[]")
  clientTiers        Json     @default("[]")
  healthScoreWeights Json     @default("[]")
  /** Scoring engine config: client + project factors, bands, override rules. See scoring.service.ts. */
  scoringConfig      Json     @default("{}")
  /** Lead intake rules (validation, duplicates, routing, scoring, SLA). See lead-rules.service. */
  leadRules          Json     @default("{}")
  taskStatuses       Json     @default("[]")
  taskAutomation     Boolean  @default(true)
  /** Department → allowed task types. `[]` = no restriction (see TeamService). */
  departmentTaskTypes Json    @default("[]")
  notifications      Json     @default("[]")
  integrations       Json     @default("[]")
  emailTemplates     Json     @default("[]")
  appearance         Json     @default("{}")
  /// Admin-only config: security policy, system flags, SMTP. Kept out of the
  /// public settings sections so it can never be written by a normal save.
  adminConfig        Json     @default("{}")
  updatedAt          DateTime @updatedAt
}

model LeadCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())
  leads     Lead[]
}

model PipelineStage {
  id      String @id @default(cuid())
  name    String @unique
  order   Int    @unique
  slaDays Int    @default(5)
}

model LeadMeeting {
  id           String        @id @default(cuid())
  leadId       String
  title        String
  type         MeetingType   @default(VIDEO_CALL)
  scheduledAt  DateTime
  durationMins Int           @default(30)
  meetingLink  String?
  location     String?
  status       MeetingStatus @default(SCHEDULED)
  notes        String?
  createdById  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  attendees    Json?
  attendeeLinks LeadMeetingAttendee[]
  createdBy    User?         @relation(fields: [createdById], references: [id])
  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

/**
 * One row per employee invited to a lead meeting.
 *
 * `LeadMeeting.attendees` is a loose JSON blob of `{ id, name }` where the id is
 * a *User* id — useless for "how many meetings did this employee attend" because
 * an employee without a login has no User row. This table is the relational
 * source of truth: it keys on Employee and carries the attendance outcome.
 */
model LeadMeetingAttendee {
  id         String      @id @default(cuid())
  meetingId  String
  employeeId String
  status     String      @default("INVITED") // INVITED | ATTENDED | NO_SHOW
  markedAt   DateTime?
  createdAt  DateTime    @default(now())
  meeting    LeadMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([meetingId, employeeId])
  @@index([employeeId])
  @@index([meetingId])
}

model Lead {
  id                String           @id @default(cuid())
  name              String
  company           String?
  contactEmail      String?
  contactPhone      String?
  /** E.164-ish phone used for duplicate matching (+8801XXXXXXXXX). */
  phoneNormalized   String?
  /** Rule-engine flags: NO_PHONE, NO_COMPANY, DUPLICATE, STALE, SLA_BREACH, UNASSIGNED. */
  qualityFlags      String[]         @default([])
  source            LeadSource       @default(OTHER)
  vertical          Vertical         @default(OTHER)
  stage             LeadStage        @default(NEW)
  leadScore         Int?             @default(0)
  estimatedDealSize Decimal?         @db.Decimal(14, 2)
  currency          String           @default("BDT")
  assignedToId      String?
  convertedClientId String?          @unique
  lastContactedAt   DateTime?
  /** What the lead needs — sector, requirement, budget, timeline. Shown at the top of the lead view. */
  description       String?
  notes             String?
  createdAt         DateTime         @default(now())
  priority          LeadPriority     @default(MEDIUM)
  stageEnteredAt    DateTime?        @default(now())
  firstResponseAt   DateTime?
  nextFollowUpAt    DateTime?
  temperature       LeadTemperature  @default(WARM)
  probability       Int              @default(50)
  starred           Boolean          @default(false)
  tags              String[]         @default([])
  website           String?
  pageLink          String?
  uid               String?          @unique
  leadCategoryId    String?
  assignedTo        User?            @relation(fields: [assignedToId], references: [id])
  client            Client?          @relation("ClientFromLead", fields: [convertedClientId], references: [id])
  leadCategory      LeadCategory?    @relation(fields: [leadCategoryId], references: [id])
  activities        LeadActivity[]
  attachments       LeadAttachment[]
  followUps         LeadFollowUp[]
  meetings          LeadMeeting[]
  notesList         LeadNote[]
  lostReason        LostReason?
  projects          Project[]        @relation("ProjectSourceLead")
  proposals         Proposal[]

  @@index([stage])
  @@index([assignedToId])
  @@index([leadCategoryId])
  @@index([leadScore])
  @@index([createdAt])
  @@index([nextFollowUpAt])
  @@index([temperature])
  @@index([priority])
  @@index([stage, createdAt])
  @@index([phoneNormalized])
}

model LeadNote {
  id          String   @id @default(cuid())
  leadId      String
  content     String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation(fields: [createdById], references: [id])
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([createdById])
}

model LeadAttachment {
  id           String   @id @default(cuid())
  leadId       String
  title        String?
  fileUrl      String
  filename     String
  mimeType     String?
  sizeBytes    Int?
  uploadedById String?
  createdAt    DateTime @default(now())
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])

  @@index([leadId])
  @@index([uploadedById])
}

model LeadFollowUp {
  id        String         @id @default(cuid())
  leadId    String
  date      DateTime
  notes     String         @default("")
  status    FollowUpStatus @default(SCHEDULED)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  lead      Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, status, date])
}

model LeadActivity {
  id         String       @id @default(cuid())
  leadId     String
  type       ActivityType
  content    String
  loggedById String?
  loggedAt   DateTime     @default(now())
  changes    Json?
  lead       Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  loggedBy   User?        @relation(fields: [loggedById], references: [id])

  @@index([leadId])
  @@index([loggedAt])
}

model Proposal {
  id               String         @id @default(cuid())
  leadId           String
  versionNumber    Int            @default(1)
  fileUrl          String?
  portalLink       String?
  sentDate         DateTime?
  viewed           Boolean        @default(false)
  viewDurationSecs Int?           @default(0)
  status           ProposalStatus @default(DRAFT)
  createdAt        DateTime       @default(now())
  project          Project?       @relation("ProjectSourceProposal")
  lead             Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model LostReason {
  id             String             @id @default(cuid())
  leadId         String             @unique
  reasonCategory LostReasonCategory
  notes          String?
  recordedAt     DateTime           @default(now())
  lead           Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Client {
  id                        String             @id @default(cuid())
  companyName               String
  industryVertical          Vertical           @default(OTHER)
  accountOwnerId            String?
  healthScore               Int?               @default(75)
  healthLevel               HealthLevel        @default(GREEN)
  healthDriver              String?
  /// Factor-level breakdown of the last score (see scoring.service.ts).
  healthBreakdown           Json?
  /// When the score was last computed by the engine.
  healthComputedAt          DateTime?
  /// Explicit segment profile id from the scoring config. Null = derive from billing cycle.
  scoreProfile              String?
  billingCycleType          BillingCycleType   @default(MONTHLY_RETAINER)
  currencyPreference        String             @default("BDT")
  contractStartDate         DateTime?
  renewalDate               DateTime?
  notes                     String?
  createdAt                 DateTime           @default(now())
  category                  ClientCategory     @default(ACTIVE)
  autoGenerateInvoice       Boolean            @default(true)
  billingDayOfMonth         Int?
  lastAutoInvoiceCycle      String?
  monthlyAmount             Decimal?           @db.Decimal(14, 2)
  monthlyServiceDescription String?
  paymentDueDays            Int?               @default(15)
  nextRetainerDate          DateTime?          @db.Date
  retainerInterval          String?            @default("MONTHLY")
  adAccounts                AdAccount[]
  adInsights                AdInsight[]
  alertRules                AlertRule[]
  calendarEvents            CalendarEvent[]
  churnFlags                ChurnRiskFlag[]
  accountOwner              User?              @relation(fields: [accountOwnerId], references: [id])
  contacts                  ClientContact[]
  documents                 ClientDocument[]
  healthLogs                ClientHealthLog[]
  creditBalances            CreditBalance[]
  creditNotes               CreditNote[]
  expense                   Expense[]
  invoices                  Invoice[]
  lead                      Lead?              @relation("ClientFromLead")
  projects                  Project[]
  clientComments            ClientComment[]
  reportDefinitions         ReportDefinition[]
  vendorEngagements         VendorEngagement[]
  dollarSales               DollarSale[]
  manualIncome              ManualIncome[]

  @@index([accountOwnerId])
  @@index([category])
}

model ClientContact {
  id                  String      @id @default(cuid())
  clientId            String
  name                String
  roleTitle           String?
  email               String?     @unique
  phone               String?
  isPrimary           Boolean     @default(false)
  portalAccessEnabled Boolean     @default(false)
  lastPortalLogin     DateTime?
  whatsappOptIn       Boolean     @default(true)
  client              Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  portalUser          PortalUser?
}

model ClientDocument {
  id           String        @id @default(cuid())
  clientId     String
  type         ClientDocType
  fileUrl      String
  uploadedById String?
  isEncrypted  Boolean       @default(false)
  uploadedAt   DateTime      @default(now())
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uploadedBy   User?         @relation(fields: [uploadedById], references: [id])
}

model ClientHealthLog {
  id            String   @id @default(cuid())
  clientId      String
  score         Int
  level         HealthLevel?
  driverSummary String?
  /// Per-factor contributions captured at computation time.
  breakdown     Json?
  recordedAt    DateTime @default(now())
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ChurnRiskFlag {
  id             String    @id @default(cuid())
  clientId       String
  riskLevel      RiskLevel
  matchedPattern String?
  flaggedAt      DateTime  @default(now())
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ProjectTemplate {
  id                    String    @id @default(cuid())
  name                  String
  description           String?
  benchmarkDurationDays Int?
  benchmarkHours        Int?
  defaultTaskList       Json?
  projects              Project[]
}

model Project {
  id                String               @id @default(cuid())
  clientId          String
  name              String
  type              ProjectType          @default(FIXED)
  templateId        String?
  startDate         DateTime
  targetEndDate     DateTime?
  status            ProjectStatus        @default(ACTIVE)
  healthStatus      HealthStatus         @default(ON_TRACK)
  riskScore         Int?                 @default(0)
  riskDriver        String?
  /// PM's 1-5 forward-looking confidence, the only subjective input in the score.
  confidenceScore   Int?
  /// Manual override of the computed health level. When set it wins over the engine.
  healthStatusOverride HealthStatus?
  healthOverrideReason String?
  healthComputedAt  DateTime?
  healthBreakdown   Json?
  budgetAmount      Decimal?             @db.Decimal(14, 2)
  currency          String               @default("BDT")
  assignedPmId      String?
  createdAt         DateTime             @default(now())
  sourceLeadId      String?
  sourceProposalId  String?              @unique
  uid               String?              @unique
  category          String?              @default("")
  priority          String?              @default("MEDIUM")
  progress          Int                  @default(0)
  spentAmount       Decimal?             @db.Decimal(14, 2)
  team              String[]             @default([])
  billingType       BillingCycle         @default(ONE_TIME)
  recurringInterval String?
  nextBillingDate   DateTime?
  monthlyRate       Decimal?             @db.Decimal(14, 2)
  totalBilled       Decimal?             @db.Decimal(14, 2)
  paymentStatus     String               @default("PENDING")
  briefLink         String?
  driveLink         String?
  researchLink      String?
  description       String?
  amount            Decimal?             @db.Decimal(14, 2)
  projectLink       String?
  websiteUrl        String?
  socialLinks       Json?
  nextReportDate    DateTime?
  reportFrequency   String?
  reportMode        String               @default("MANUAL")
  budgets           Budget[]
  calendarEvents    CalendarEvent[]
  comments          ClientComment[]
  contentPosts      ContentPost[]
  expenses          Expense[]
  invoices          Invoice[]
  milestones        Milestone[]
  assignedPm        User?                @relation(fields: [assignedPmId], references: [id])
  client            Client               @relation(fields: [clientId], references: [id])
  sourceLead        Lead?                @relation("ProjectSourceLead", fields: [sourceLeadId], references: [id])
  sourceProposal    Proposal?            @relation("ProjectSourceProposal", fields: [sourceProposalId], references: [id])
  template          ProjectTemplate?     @relation(fields: [templateId], references: [id])
  deliverables      ProjectDeliverable[]
  files             ProjectFile[]
  references        ProjectReference[]
  reports           ProjectReport[]
  riskLogs          ProjectRiskLog[]
  sprints           Sprint[]
  tasks             Task[]
  vendorEngagements VendorEngagement[]
  manualIncome      ManualIncome[]

  @@index([clientId])
  @@index([assignedPmId])
}

model ProjectReference {
  id           String        @id @default(cuid())
  projectId    String
  title        String
  url          String?
  type         ReferenceType @default(OTHER)
  fileUrl      String?
  uploadedById String?
  createdAt    DateTime      @default(now())
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy   User?         @relation(fields: [uploadedById], references: [id])

  @@index([projectId])
}

model Milestone {
  id            String          @id @default(cuid())
  projectId     String
  name          String
  dueDate       DateTime?
  status        MilestoneStatus @default(PENDING)
  clientVisible Boolean         @default(false)
  completedAt   DateTime?
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  files         ProjectFile[]

  @@index([projectId])
}

model ProjectFile {
  id             String             @id @default(cuid())
  projectId      String
  milestoneId    String?
  fileUrl        String
  /// Display metadata captured at upload time (the blob itself is on disk).
  fileName       String?
  size           Int?
  mimeType       String?
  versionNumber  Int                @default(1)
  uploadedById   String?
  approvalStatus FileApprovalStatus @default(PENDING)
  approvedAt     DateTime?
  uploadedAt     DateTime           @default(now())
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone      Milestone?         @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  uploadedBy     User?              @relation(fields: [uploadedById], references: [id])

  @@index([projectId])
  @@index([milestoneId])
}

model ProjectDeliverable {
  id          String            @id @default(cuid())
  projectId   String
  title       String
  description String?
  sortOrder   Int               @default(0)
  status      DeliverableStatus @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([projectId])
}

model ProjectReport {
  id            String       @id @default(cuid())
  projectId     String
  title         String
  periodStart   DateTime
  periodEnd     DateTime
  status        ReportStatus @default(DRAFT)
  completed     Json         @default("[]")
  pending       Json         @default("[]")
  billing       Json?
  pmNotes       String?
  generatedById String?
  createdAt     DateTime     @default(now())
  sentAt        DateTime?
  generatedBy   User?        @relation("ReportGeneratedBy", fields: [generatedById], references: [id])
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectRiskLog {
  id            String   @id @default(cuid())
  projectId     String
  riskScore     Int
  primaryDriver String?
  /// Per-factor contributions captured at computation time.
  breakdown     Json?
  calculatedAt  DateTime @default(now())
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Task {
  id                  String              @id @default(cuid())
  projectId           String?
  title               String
  description         String?
  assignedToId        String?
  priority            Priority            @default(MEDIUM)
  dueDate             DateTime?
  status              TaskStatus          @default(TODO)
  estimatedHours      Decimal?            @db.Decimal(8, 2)
  parentTaskId        String?
  isClientVisible     Boolean             @default(false)
  isRecurring         Boolean             @default(false)
  recurrenceSchedule  String?
  createdAt           DateTime            @default(now())
  tags                String[]            @default([])
  isBlocked           Boolean             @default(false)
  referenceLinks      Json?               @default("[]")
  activityLog         Json?               @default("[]")
  taskType            String              @default("general")
  startDate           DateTime?
  actualHours         Decimal             @default(0) @db.Decimal(8, 2)
  sortOrder           Int                 @default(0)
  archivedAt          DateTime?
  attachments         Json?               @default("[]")
  assignees           Json?               @default("[]")
  customFields        Json?               @default("[]")
  reporterId          String?
  deliverableId       String?
  completedAt         DateTime?
  recurrenceSpawnedAt DateTime?
  sprintId            String?
  assignedAt          DateTime?
  assignedById        String?
  reportDefinitions   ReportDefinition[]
  assignedBy          Employee?           @relation("taskAssigner", fields: [assignedById], references: [id])
  assignedTo          Employee?           @relation(fields: [assignedToId], references: [id])
  deliverable         ProjectDeliverable? @relation(fields: [deliverableId], references: [id])
  project             Project?            @relation(fields: [projectId], references: [id])
  reporter            Employee?           @relation("taskReporter", fields: [reporterId], references: [id])
  sprint              Sprint?             @relation(fields: [sprintId], references: [id])
  checklist           TaskChecklistItem[]
  comments            TaskComment[]
  dependents          TaskDependency[]    @relation("dependsOnTask")
  dependencies        TaskDependency[]    @relation("taskDependsOn")
  timers              TaskTimer[]
  timeLogs            TimeLog[]

  @@index([assignedToId])
  @@index([status])
  @@index([projectId])
  @@index([sprintId])
}

model TaskChecklistItem {
  id        String    @id @default(cuid())
  taskId    String
  content   String
  done      Boolean   @default(false)
  sortOrder Int       @default(0)
  doneById  String?
  doneAt    DateTime?
  createdAt DateTime  @default(now())
  doneBy    Employee? @relation(fields: [doneById], references: [id])
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskTimer {
  id         String    @id @default(cuid())
  taskId     String
  employeeId String?
  startedAt  DateTime  @default(now())
  stoppedAt  DateTime?
  notes      String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([employeeId, stoppedAt])
}

model Sprint {
  id            String                @id @default(cuid())
  name          String
  goal          String?
  projectId     String?
  startDate     DateTime
  endDate       DateTime
  status        SprintStatus          @default(PLANNED)
  capacityHours Decimal?              @db.Decimal(8, 2)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  project       Project?              @relation(fields: [projectId], references: [id])
  snapshots     SprintDailySnapshot[]
  tasks         Task[]

  @@index([projectId])
  @@index([status])
}

model SprintDailySnapshot {
  id             String   @id @default(cuid())
  sprintId       String
  date           DateTime @db.Date
  total          Int
  done           Int
  open           Int
  remaining      Int
  estimatedHours Decimal  @default(0) @db.Decimal(10, 2)
  actualHours    Decimal  @default(0) @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  sprint         Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@unique([sprintId, date])
  @@index([sprintId])
}

model SavedTaskView {
  id        String   @id @default(cuid())
  ownerId   String?
  name      String
  filters   Json     @default("{}")
  viewMode  String   @default("board")
  groupBy   String   @default("project")
  isShared  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model TaskDependency {
  id              String @id @default(cuid())
  taskId          String
  dependsOnTaskId String
  type            String @default("blocked-by")
  dependsOnTask   Task   @relation("dependsOnTask", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
  task            Task   @relation("taskDependsOn", fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
}

model TimeLog {
  id         String    @id @default(cuid())
  taskId     String
  employeeId String?
  hours      Decimal   @db.Decimal(6, 2)
  date       DateTime
  loggedVia  LoggedVia @default(MANUAL)
  notes      String?
  createdAt  DateTime  @default(now())
  isBillable Boolean   @default(true)
  employee   Employee? @relation(fields: [employeeId], references: [id])
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([employeeId, date])
}

model TaskComment {
  id               String        @id @default(cuid())
  taskId           String
  authorId         String?
  content          String
  mentionedUserIds Json?
  createdAt        DateTime      @default(now())
  parentId         String?
  reactions        Json?         @default("[]")
  author           User?         @relation(fields: [authorId], references: [id])
  parent           TaskComment?  @relation("commentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies          TaskComment[] @relation("commentReplies")
  task             Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model EstimateAccuracyLog {
  id             String    @id @default(cuid())
  employeeId     String?
  taskType       String?
  estimatedHours Decimal?  @db.Decimal(8, 2)
  actualHours    Decimal?  @db.Decimal(8, 2)
  varianceRatio  Float?
  taskId         String?
  createdAt      DateTime  @default(now())
  employee       Employee? @relation(fields: [employeeId], references: [id])
}

model Employee {
  id                       String                 @id @default(cuid())
  name                     String
  roleTitle                String
  department               String?
  joinDate                 DateTime
  reportingManagerId       String?
  employmentStatus         EmploymentStatus       @default(ACTIVE)
  costRate                 Decimal?               @db.Decimal(14, 2)
  skillTags                String[]               @default([])
  email                    String?
  phone                    String?
  workLocation             String                 @default("Remote")
  employmentType           String                 @default("full-time")
  salary                   Decimal?               @db.Decimal(14, 2)
  payFrequency             String                 @default("monthly")
  documents                Json?                  @default("[]")
  careerHistory            Json?                  @default("[]")
  deviceId                 String?                @unique
  weeklyOffDays            String[]               @default([])
  // No default: NULL means "follow AttendancePolicy". A non-null value is an
  // explicit per-employee schedule. The old @default("10:00") made every row
  // non-null, so policy shift changes could never reach anyone.
  shiftStart               String?
  shiftEnd                 String?
  graceMinutes             Int?
  education                String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  weeklyCapacityHours      Decimal?               @db.Decimal(6, 2)
  attendance               Attendance[]
  attendanceCorrections    AttendanceCorrection[]
  attritionFlags           AttritionRiskFlag[]
  reportingManager         Employee?              @relation("reportsTo", fields: [reportingManagerId], references: [id])
  reports                  Employee[]             @relation("reportsTo")
  estimateLogs             EstimateAccuracyLog[]
  leaveBalances            LeaveBalance[]
  leaveRequests            LeaveRequest[]
  meetingAttendances       LeadMeetingAttendee[]
  okrs                     Okr[]
  payrollRecords           PayrollRecord[]
  performanceReviews       PerformanceReview[]
  punches                  PunchLog[]
  assignedTasks            Task[]                 @relation("taskAssigner")
  tasks                    Task[]
  reportedTasks            Task[]                 @relation("taskReporter")
  checklistItems           TaskChecklistItem[]
  timers                   TaskTimer[]
  timeLogs                 TimeLog[]
  enrollments              TrainingEnrollment[]
  checklists               EmployeeChecklist[]
  assets                   Asset[]
  telegramLink             TelegramLink?
  user                     User?
  utilizationLogs          UtilizationLog[]
}

model Attendance {
  id                  String                 @id @default(cuid())
  employeeId          String
  date                DateTime               @db.Date
  checkInTime         DateTime?
  checkOutTime        DateTime?
  status              AttendanceStatus       @default(PRESENT)
  isManuallyCorrected Boolean                @default(false)
  // Which fields HR edited by hand. The nightly recompute keeps these and
  // refreshes the rest, so a manual fix survives while punches still flow.
  correctedFields     String[]               @default([])
  correctedById       String?
  correctedBy         User?                  @relation(fields: [correctedById], references: [id])
  employee            Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  corrections         AttendanceCorrection[]

  @@unique([employeeId, date])
  @@index([date])
}

model LeaveRequest {
  id            String      @id @default(cuid())
  employeeId    String
  leaveType     LeaveType
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  status        LeaveStatus @default(PENDING)
  approvedById  String?
  appliedAt     DateTime    @default(now())
  balanceAfter  Decimal?    @db.Decimal(5, 1)
  balanceBefore Decimal?    @db.Decimal(5, 1)
  decidedAt     DateTime?
  decisionNote  String?
  deductedDays  Decimal?    @db.Decimal(5, 1)
  workingDays   Int?
  approvedBy    User?       @relation("LeaveApproval", fields: [approvedById], references: [id])
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  leaveType   LeaveType
  balanceDays Decimal   @db.Decimal(5, 1)
  period      String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveType, period])
}

model PayrollRecord {
  id                   String        @id @default(cuid())
  employeeId           String
  period               String
  basicSalary          Decimal       @db.Decimal(14, 2)
  allowances           Decimal       @default(0) @db.Decimal(14, 2)
  deductions           Decimal       @default(0) @db.Decimal(14, 2)
  unpaidLeaveDeduction Decimal       @default(0) @db.Decimal(14, 2)
  bonus                Decimal       @default(0) @db.Decimal(14, 2)
  netPay               Decimal       @db.Decimal(14, 2)
  status               PayrollStatus @default(DRAFT)
  auditTrail           Json?         @default("[]")
  createdAt            DateTime      @default(now())
  lateDeduction        Decimal       @default(0) @db.Decimal(14, 2)
  halfDayDeduction     Decimal       @default(0) @db.Decimal(14, 2)
  absentDeduction      Decimal       @default(0) @db.Decimal(14, 2)
  breakdown            Json?         @default("{}")
  salaryExpense        Expense?
  employee             Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // One payroll record per person per month. Without this, two concurrent
  // runs (double click, two HR users) both pass the "already exists?" check
  // and salary is paid twice.
  @@unique([employeeId, period])
  @@index([period])
}

model PerformanceReview {
  id               String    @id @default(cuid())
  employeeId       String
  reviewPeriod     String
  selfScore        Decimal?  @db.Decimal(5, 2)
  managerScore     Decimal?  @db.Decimal(5, 2)
  objectiveSignals Json?     @default("{}")
  goalsSet         Json?     @default("[]")
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  status           String    @default("PENDING")
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedBy       User?     @relation(fields: [reviewedById], references: [id])
}

model UtilizationLog {
  id              String   @id @default(cuid())
  employeeId      String
  weekStartDate   DateTime @db.Date
  billableHours   Decimal  @db.Decimal(6, 2)
  availableHours  Decimal  @db.Decimal(6, 2)
  utilizationRate Float
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, weekStartDate])
}

model AttritionRiskFlag {
  id                  String    @id @default(cuid())
  employeeId          String
  riskLevel           RiskLevel
  contributingFactors String?
  flaggedAt           DateTime  @default(now())
  employee            Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Okr {
  id              String   @id @default(cuid())
  employeeId      String
  title           String
  quarter         String
  keyResults      Json     @default("[]")
  overallProgress Float    @default(0)
  status          String   @default("on-track")
  createdAt       DateTime @default(now())
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model TrainingCourse {
  id          String               @id @default(cuid())
  title       String
  description String               @default("")
  type        String               @default("optional")
  category    String               @default("technical")
  duration    Float                @default(0)
  provider    String               @default("")
  format      String               @default("online")
  createdAt   DateTime             @default(now())
  enrollments TrainingEnrollment[]
}

model TrainingEnrollment {
  id          String         @id @default(cuid())
  courseId    String
  employeeId  String
  status      String         @default("enrolled")
  progress    Float          @default(0)
  enrolledAt  DateTime       @default(now())
  completedAt DateTime?
  course      TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([courseId, employeeId])
}

model Candidate {
  id             String   @id @default(cuid())
  firstName      String
  lastName       String
  email          String
  phone          String   @default("")
  position       String
  department     String   @default("")
  stage          String   @default("applied")
  source         String   @default("")
  appliedAt      String
  notes          Json     @default("[]")
  interviews     Json     @default("[]")
  rating         Float    @default(0)
  expectedSalary Decimal? @db.Decimal(14, 2)
  skills         Json     @default("[]")
  createdAt      DateTime @default(now())
}

model Holiday {
  id           String   @id @default(cuid())
  date         String   @unique
  name         String
  description  String?
  createdAt    DateTime @default(now())
  tentative    Boolean  @default(false)
  isGovernment Boolean  @default(true)
}

model WorkdayOverride {
  id          String   @id @default(cuid())
  date        String   @unique
  isOpen      Boolean
  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation(fields: [createdById], references: [id])
}

model LeavePolicy {
  id          String    @id @default(cuid())
  leaveType   LeaveType @unique
  annualDays  Decimal?  @db.Decimal(5, 1)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AttendancePolicy {
  id                       String   @id @default("default")
  weeklyOffDays            String[] @default(["FRIDAY", "SATURDAY"])
  graceMinutes             Int      @default(15)
  shiftStart               String   @default("10:00")
  shiftEnd                 String   @default("18:00")
  halfDayCutoff            String   @default("12:00")
  lateLadder               Json     @default("[{\"days\": 1, \"lates\": 3}, {\"days\": 2, \"lates\": 6}, {\"days\": 3, \"lates\": 9}]")
  dailyRateDivisor         Int      @default(26)
  proRataEnabled           Boolean  @default(false)
  updatedAt                DateTime @default(now()) @updatedAt
  overtimeThresholdMinutes Int      @default(30)
}

model PunchLog {
  id           String    @id @default(cuid())
  deviceId     String
  employeeId   String?
  punchTime    DateTime
  verifyMethod String?
  workCode     String?
  deviceSn     String?
  source       String    @default("DEVICE")
  isProcessed  Boolean   @default(false)
  unmatched    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  employee     Employee? @relation(fields: [employeeId], references: [id])

  // A device retrying an ATTLOG batch must not create the same punch twice.
  @@unique([deviceId, punchTime])
  @@index([employeeId, punchTime])
  @@index([punchTime])
  @@index([unmatched])
}

model AttendanceDevice {
  id           String    @id @default(cuid())
  name         String?
  serialNumber String    @unique
  location     String?
  isActive     Boolean   @default(true)
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model AttendanceCorrection {
  id            String     @id @default(cuid())
  attendanceId  String
  employeeId    String
  field         String
  oldValue      String?
  newValue      String?
  reason        String?
  correctedById String?
  createdAt     DateTime   @default(now())
  attendance    Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  correctedBy   User?      @relation(fields: [correctedById], references: [id])
  employee      Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([attendanceId])
}

model Account {
  id           String               @id @default(cuid())
  name         String
  category     AccountCategory
  isActive     Boolean              @default(true)
  code         String?
  expenses     Expense[]
  categoryDefs ExpenseCategoryDef[]
  journalLines JournalEntryLine[]
}

model Vendor {
  id           String    @id @default(cuid())
  name         String
  contactInfo  String?
  category     String?
  address      String?
  bankDetails  String?
  createdAt    DateTime  @default(now())
  email        String?
  isActive     Boolean   @default(true)
  paymentTerms String?
  phone        String?
  expenses     Expense[]
  engagements  VendorEngagement[]
}

/// A contractual commitment to a vendor (crew, studio, freelancer…).
/// totalAmount is what we agreed; payments record cash out; the balance is the
/// liability still owed. Kept separate from Expense so commitments never
/// disappear into a single "misc" line.
model VendorEngagement {
  id             String                  @id @default(cuid())
  reference      String                  @unique
  vendorId       String
  projectId      String?
  clientId       String?
  title          String
  category       VendorEngagementCategory @default(OTHER)
  description    String?
  totalAmount    Decimal                 @db.Decimal(14, 2)
  currency       String                  @default("BDT")
  status         VendorEngagementStatus  @default(ACTIVE)
  startDate      DateTime?               @db.Date
  dueDate        DateTime?               @db.Date
  deliveredAt    DateTime?               @db.Date
  billNumber     String?
  billReceivedAt DateTime?               @db.Date
  retentionPct   Decimal?                @default(0) @db.Decimal(5, 2)
  paymentTerms   String?
  notes          String?
  attachmentUrl  String?
  createdById    String?
  approvedById   String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  vendor         Vendor                  @relation(fields: [vendorId], references: [id])
  project        Project?                @relation(fields: [projectId], references: [id])
  client         Client?                 @relation(fields: [clientId], references: [id])
  payments       VendorPayment[]

  @@index([vendorId])
  @@index([projectId])
  @@index([status])
  @@index([dueDate])
}

/// Cash actually paid against an engagement. `taxWithheld` is TDS/VDS kept back
/// (the liability is still settled by the gross amount, the vendor receives net).
model VendorPayment {
  id            String            @id @default(cuid())
  engagementId  String
  amount        Decimal           @db.Decimal(14, 2)
  type          VendorPaymentType @default(PARTIAL)
  paymentDate   DateTime          @db.Date
  paymentMethod PaymentMethod     @default(CASH)
  referenceId   String?
  bankAccountId String?
  taxWithheld   Decimal?          @default(0) @db.Decimal(14, 2)
  notes         String?
  recordedById  String?
  createdAt     DateTime          @default(now())
  engagement    VendorEngagement  @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([engagementId])
  @@index([paymentDate])
}

enum VendorEngagementStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum VendorPaymentType {
  ADVANCE
  PARTIAL
  FINAL
  REFUND
}

enum VendorEngagementCategory {
  CREW
  EQUIPMENT
  STUDIO
  LOCATION
  POST_PRODUCTION
  TALENT
  TRANSPORT
  CATERING
  FREELANCE
  OTHER
}

/// A direct dollar sale to a client. No project is required — the client buys
/// currency from us and pays BDT. costRate is a snapshot of the configured rate
/// at sale time, so changing the rate later never rewrites historical profit.
model DollarSale {
  id            String        @id @default(cuid())
  reference     String        @unique
  clientId      String
  usdAmount     Decimal       @db.Decimal(14, 2)
  bdtAmount     Decimal       @db.Decimal(14, 2)
  costRate      Decimal       @db.Decimal(10, 4)
  effectiveRate Decimal       @db.Decimal(10, 4)
  costBdt       Decimal       @db.Decimal(14, 2)
  profit        Decimal       @db.Decimal(14, 2)
  marginPct     Decimal       @db.Decimal(8, 2)
  date          DateTime      @db.Date
  paymentMethod PaymentMethod @default(BANK_TRANSFER)
  bankAccountId String?
  notes         String?
  recordedById  String?
  createdAt     DateTime      @default(now())
  client        Client        @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([date])
}

model Expense {
  id                 String           @id @default(cuid())
  description        String
  amount             Decimal          @db.Decimal(14, 2)
  currency           String           @default("BDT")
  exchangeRate       Decimal?         @default(1) @db.Decimal(10, 4)
  accountId          String?
  date               DateTime         @db.Date
  vendorId           String?
  paymentMethod      PaymentMethod    @default(CASH)
  isClientBillable   Boolean          @default(false)
  clientId           String?
  projectId          String?
  receiptUrl         String?
  approvalStatus     ApprovalStatus   @default(APPROVED)
  submittedById      String?
  approvedById       String?
  isRecurring        Boolean          @default(false)
  recurrenceSchedule String?
  createdAt          DateTime         @default(now())
  balanceDeducted    Boolean          @default(false)
  bankAccountId      String?
  payrollRecordId    String?          @unique
  dueDate            DateTime?        @db.Date
  isPayable          Boolean          @default(false)
  paidAmount         Decimal?         @default(0) @db.Decimal(14, 2)
  subcategory        String?
  category           String           @default("MISC")
  vendorBillNumber   String?
  vendorBillDate     DateTime?        @db.Date
  notes              String?
  department         String?
  markupPct          Decimal?         @default(0) @db.Decimal(5, 2)
  account            Account?         @relation(fields: [accountId], references: [id])
  approvedBy         User?            @relation("ExpenseApproved", fields: [approvedById], references: [id])
  bankAccount        BankAccount?     @relation(fields: [bankAccountId], references: [id])
  client             Client?          @relation(fields: [clientId], references: [id])
  payrollRecord      PayrollRecord?   @relation(fields: [payrollRecordId], references: [id])
  project            Project?         @relation(fields: [projectId], references: [id])
  submittedBy        User?            @relation("ExpenseSubmitted", fields: [submittedById], references: [id])
  vendor             Vendor?          @relation(fields: [vendorId], references: [id])
  linkedInvoiceLine  InvoiceLineItem?
