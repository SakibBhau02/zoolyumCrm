  project     Project?   @relation(fields: [projectId], references: [id])

  @@index([clientId, periodStart])
  @@index([status])
}

model CalendarComment {
  id         String   @id @default(cuid())
  source     String
  sourceId   String
  authorId   String?
  content    String
  isInternal Boolean  @default(true)
