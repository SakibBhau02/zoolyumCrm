model Holiday {
  id           String   @id @default(cuid())
  date         String   @unique
  name         String
  description  String?
  createdAt    DateTime @default(now())
  tentative    Boolean  @default(false)
  isGovernment Boolean  @default(true)
}

model WorkdayOverride {
  id          String   @id @default(cuid())
  date        String   @unique
  isOpen      Boolean
  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation(fields: [createdById], references: [id])
}

model LeavePolicy {
  id          String    @id @default(cuid())
  leaveType   LeaveType @unique
  annualDays  Decimal?  @db.Decimal(5, 1)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AttendancePolicy {
  id                       String   @id @default("default")
  weeklyOffDays            String[] @default(["FRIDAY", "SATURDAY"])
  graceMinutes             Int      @default(15)
  shiftStart               String   @default("10:00")
  shiftEnd                 String   @default("18:00")
  halfDayCutoff            String   @default("12:00")
  lateLadder               Json     @default("[{\"days\": 1, \"lates\": 3}, {\"days\": 2, \"lates\": 6}, {\"days\": 3, \"lates\": 9}]")
  dailyRateDivisor         Int      @default(26)
  proRataEnabled           Boolean  @default(false)
  updatedAt                DateTime @default(now()) @updatedAt
  overtimeThresholdMinutes Int      @default(30)
}

model PunchLog {
  id           String    @id @default(cuid())
  deviceId     String
  employeeId   String?
  punchTime    DateTime
  verifyMethod String?
  workCode     String?
  deviceSn     String?
  source       String    @default("DEVICE")
  isProcessed  Boolean   @default(false)
  unmatched    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  employee     Employee? @relation(fields: [employeeId], references: [id])

  // A device retrying an ATTLOG batch must not create the same punch twice.
  @@unique([deviceId, punchTime])
  @@index([employeeId, punchTime])
  @@index([punchTime])
  @@index([unmatched])
}

model AttendanceDevice {
  id           String    @id @default(cuid())
  name         String?
  serialNumber String    @unique
  location     String?
  isActive     Boolean   @default(true)
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model AttendanceCorrection {
  id            String     @id @default(cuid())
  attendanceId  String
  employeeId    String
  field         String
  oldValue      String?
  newValue      String?
  reason        String?
  correctedById String?
  createdAt     DateTime   @default(now())
  attendance    Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  correctedBy   User?      @relation(fields: [correctedById], references: [id])
  employee      Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([attendanceId])
}

model Account {
  id           String               @id @default(cuid())
  name         String
  category     AccountCategory
  isActive     Boolean              @default(true)
  code         String?
  expenses     Expense[]
  categoryDefs ExpenseCategoryDef[]
  journalLines JournalEntryLine[]
}

model Vendor {
  id           String             @id @default(cuid())
  name         String
  contactInfo  String?
  category     String?
  address      String?
  bankDetails  String?
  createdAt    DateTime           @default(now())
  email        String?
  isActive     Boolean            @default(true)
  paymentTerms String?
  phone        String?
  expenses     Expense[]
  engagements  VendorEngagement[]
  shootCrew    ShootCrew[]
}

/// A contractual commitment to a vendor (crew, studio, freelancer…).
/// totalAmount is what we agreed; payments record cash out; the balance is the
/// liability still owed. Kept separate from Expense so commitments never
/// disappear into a single "misc" line.
model VendorEngagement {
  id             String                   @id @default(cuid())
  reference      String                   @unique
  vendorId       String
  projectId      String?
  clientId       String?
  title          String
  category       VendorEngagementCategory @default(OTHER)
  description    String?
  totalAmount    Decimal                  @db.Decimal(14, 2)
  currency       String                   @default("BDT")
  status         VendorEngagementStatus   @default(ACTIVE)
  startDate      DateTime?                @db.Date
  dueDate        DateTime?                @db.Date
  deliveredAt    DateTime?                @db.Date
  billNumber     String?
  billReceivedAt DateTime?                @db.Date
  retentionPct   Decimal?                 @default(0) @db.Decimal(5, 2)
  paymentTerms   String?
  notes          String?
  attachmentUrl  String?
  createdById    String?
  approvedById   String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  vendor         Vendor                   @relation(fields: [vendorId], references: [id])
  project        Project?                 @relation(fields: [projectId], references: [id])
  client         Client?                  @relation(fields: [clientId], references: [id])
  payments       VendorPayment[]

  @@index([vendorId])
  @@index([projectId])
  @@index([status])
  @@index([dueDate])
}

/// Cash actually paid against an engagement. `taxWithheld` is TDS/VDS kept back
/// (the liability is still settled by the gross amount, the vendor receives net).
model VendorPayment {
  id            String            @id @default(cuid())
  engagementId  String
  amount        Decimal           @db.Decimal(14, 2)
  type          VendorPaymentType @default(PARTIAL)
  paymentDate   DateTime          @db.Date
  paymentMethod PaymentMethod     @default(CASH)
  referenceId   String?
  bankAccountId String?
  taxWithheld   Decimal?          @default(0) @db.Decimal(14, 2)
  notes         String?
  recordedById  String?
  createdAt     DateTime          @default(now())
  engagement    VendorEngagement  @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([engagementId])
  @@index([paymentDate])
}

enum VendorEngagementStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum VendorPaymentType {
  ADVANCE
  PARTIAL
  FINAL
  REFUND
}

enum VendorEngagementCategory {
  CREW
  EQUIPMENT
  STUDIO
  LOCATION
  POST_PRODUCTION
  TALENT
  TRANSPORT
  CATERING
  FREELANCE
  OTHER
}

/// A direct dollar sale to a client. No project is required — the client buys
/// currency from us and pays BDT. costRate is a snapshot of the configured rate
/// at sale time, so changing the rate later never rewrites historical profit.
model DollarSale {
  id            String        @id @default(cuid())
  reference     String        @unique
  clientId      String
  usdAmount     Decimal       @db.Decimal(14, 2)
  bdtAmount     Decimal       @db.Decimal(14, 2)
  costRate      Decimal       @db.Decimal(10, 4)
  effectiveRate Decimal       @db.Decimal(10, 4)
  costBdt       Decimal       @db.Decimal(14, 2)
  profit        Decimal       @db.Decimal(14, 2)
  marginPct     Decimal       @db.Decimal(8, 2)
  date          DateTime      @db.Date
  paymentMethod PaymentMethod @default(BANK_TRANSFER)
  bankAccountId String?
  notes         String?
  recordedById  String?
  createdAt     DateTime      @default(now())
  client        Client        @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([date])
}

model Expense {
  id                 String           @id @default(cuid())
  description        String
  amount             Decimal          @db.Decimal(14, 2)
  currency           String           @default("BDT")
  exchangeRate       Decimal?         @default(1) @db.Decimal(10, 4)
  accountId          String?
  date               DateTime         @db.Date
  vendorId           String?
  paymentMethod      PaymentMethod    @default(CASH)
  isClientBillable   Boolean          @default(false)
  clientId           String?
  projectId          String?
  receiptUrl         String?
  approvalStatus     ApprovalStatus   @default(APPROVED)
  submittedById      String?
  approvedById       String?
  isRecurring        Boolean          @default(false)
  recurrenceSchedule String?
  createdAt          DateTime         @default(now())
  balanceDeducted    Boolean          @default(false)
  bankAccountId      String?
  payrollRecordId    String?          @unique
  dueDate            DateTime?        @db.Date
  isPayable          Boolean          @default(false)
  paidAmount         Decimal?         @default(0) @db.Decimal(14, 2)
  subcategory        String?
  category           String           @default("MISC")
  vendorBillNumber   String?
  vendorBillDate     DateTime?        @db.Date
  notes              String?
  department         String?
  markupPct          Decimal?         @default(0) @db.Decimal(5, 2)
  /// Input VAT charged on the vendor bill. Recoverable VAT is not a cost: it is
  /// debited to Input VAT Receivable instead of the expense account.
  vatRate            Decimal?         @default(0) @db.Decimal(5, 2)
  inputVatAmount     Decimal?         @default(0) @db.Decimal(14, 2)
  vatRecoverable     Boolean          @default(false)
  account            Account?         @relation(fields: [accountId], references: [id])
  approvedBy         User?            @relation("ExpenseApproved", fields: [approvedById], references: [id])
  bankAccount        BankAccount?     @relation(fields: [bankAccountId], references: [id])
  client             Client?          @relation(fields: [clientId], references: [id])
  payrollRecord      PayrollRecord?   @relation(fields: [payrollRecordId], references: [id])
  project            Project?         @relation(fields: [projectId], references: [id])
  submittedBy        User?            @relation("ExpenseSubmitted", fields: [submittedById], references: [id])
  vendor             Vendor?          @relation(fields: [vendorId], references: [id])
  linkedInvoiceLine  InvoiceLineItem?
  payments           Payment[]

  @@index([approvalStatus])
  @@index([date])
  @@index([clientId])
  @@index([projectId])
  // Hot-path indexes (production audit 2026-11)
  @@index([isPayable, approvalStatus, dueDate])
  @@index([bankAccountId])
  @@index([vendorId])
}

model ExpenseCategoryDef {
  id            String   @id @default(cuid())
  key           String   @unique
  name          String
  subcategories Json     @default("[]")
  accountId     String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  account       Account? @relation(fields: [accountId], references: [id])
}

model Invoice {
  id             String            @id @default(cuid())
  invoiceNumber  String            @unique
  clientId       String
  projectId      String?
  currency       String            @default("BDT")
  exchangeRate   Decimal?          @default(1) @db.Decimal(10, 4)
  issueDate      DateTime          @db.Date
  dueDate        DateTime?         @db.Date
  status         InvoiceStatus     @default(DRAFT)
  invoiceType    InvoiceType       @default(ONE_TIME)
  taxApplicable  Boolean           @default(false)
  taxRate        Decimal?          @db.Decimal(5, 2)
  notes          String?
  createdById    String?
  createdAt      DateTime          @default(now())
  discountAmount Decimal?          @default(0) @db.Decimal(14, 2)
  discountRate   Decimal?          @db.Decimal(5, 2)
  paymentDetails Json?
  shippingFee    Decimal?          @default(0) @db.Decimal(14, 2)
  templateStyle  String?           @default("modern-orange")
  terms          String?
  shareEnabled   Boolean           @default(true)
  shareToken     String?           @unique
  /// PENDING | APPROVED | REJECTED. Only enforced when the workspace turns on
  /// Settings.financeConfig.invoiceApprovalRequired; defaults to APPROVED.
  approvalStatus String            @default("APPROVED")
  approvedById   String?
  approvedAt     DateTime?
  rejectionNote  String?
  /// Recognise the revenue across `deferPeriods` months instead of on the issue date.
  deferRevenue   Boolean           @default(false)
  deferPeriods   Int?
  creditNotes    CreditNote[]
  installments   Installment[]
  client         Client            @relation(fields: [clientId], references: [id])
  createdBy      User?             @relation(fields: [createdById], references: [id])
  project        Project?          @relation(fields: [projectId], references: [id])
  lineItems      InvoiceLineItem[]
  reminders      InvoiceReminder[]
  payments       Payment[]

  @@index([clientId])
  @@index([status])
  @@index([issueDate])
  /// The overdue sweep flips rows by (status, dueDate) every ten minutes.
  @@index([status, dueDate])
}

model InvoiceReminder {
  id             String   @id @default(cuid())
  invoiceId      String
  type           String
  channel        String   @default("system")
  recipientEmail String?
  recipientName  String?
  subject        String?
  notes          String?
  sentById       String?
  sentAt         DateTime @default(now())
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model InvoiceLineItem {
  id              String     @id @default(cuid())
  invoiceId       String
  description     String
  quantity        Decimal    @default(1) @db.Decimal(8, 2)
  unitPrice       Decimal    @db.Decimal(14, 2)
  amount          Decimal    @db.Decimal(14, 2)
  revenueTag      RevenueTag @default(AGENCY_REVENUE)
  linkedExpenseId String?    @unique
  milestoneId     String?
  invoice         Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  linkedExpense   Expense?   @relation(fields: [linkedExpenseId], references: [id])

  // Hot-path indexes (production audit 2026-11)
  @@index([invoiceId])
}

model Payment {
  id              String        @id @default(cuid())
  invoiceId       String?
  amount          Decimal       @db.Decimal(14, 2)
  currency        String        @default("BDT")
  paymentMethod   PaymentMethod
  referenceId     String?
  paymentDate     DateTime      @db.Date
  recordedById    String?
  notes           String?
  createdAt       DateTime      @default(now())
  balanceCredited Boolean       @default(false)
  bankAccountId   String?
  exchangeRate    Decimal?      @default(1) @db.Decimal(10, 4)
  /// Rate actually used when the bank converted the receipt. When it differs
  /// from the invoice rate the gap is realised FX gain/loss.
  settlementRate  Decimal?      @db.Decimal(10, 4)
  realizedFx      Decimal?      @default(0) @db.Decimal(14, 2)
  expenseId       String?
  installmentId   String?
  type            PaymentType   @default(IN)
  taxWithheld     Decimal?      @default(0) @db.Decimal(14, 2)
  creditNote      CreditNote?   @relation("RefundPayment")
  bankAccount     BankAccount?  @relation(fields: [bankAccountId], references: [id])
  expense         Expense?      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  installment     Installment?  @relation(fields: [installmentId], references: [id])
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy      User?         @relation(fields: [recordedById], references: [id])

  @@index([paymentDate])
  @@index([invoiceId])
  @@index([expenseId])
  @@index([bankAccountId])
  // Hot-path indexes (production audit 2026-11)
  @@index([type, paymentDate])
  @@index([installmentId])
}

model Installment {
  id         String    @id @default(cuid())
  invoiceId  String
  sequence   Int
  amount     Decimal   @db.Decimal(14, 2)
  dueDate    DateTime  @db.Date
  status     String    @default("PENDING")
  paidAmount Decimal   @default(0) @db.Decimal(14, 2)
  createdAt  DateTime  @default(now())
  invoice    Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payments   Payment[]

  @@index([invoiceId])
}

model ManualIncome {
  id            String        @id @default(cuid())
  description   String
  amount        Decimal       @db.Decimal(14, 2)
  currency      String        @default("BDT")
  exchangeRate  Decimal?      @default(1) @db.Decimal(10, 4)
  category      String        @default("OTHER_INCOME")
  date          DateTime      @db.Date
  paymentMethod PaymentMethod @default(CASH)
  bankAccountId String?
  notes         String?
  recordedById  String?
  createdAt     DateTime      @default(now())
  clientId      String?
  projectId     String?
  referenceId   String?
  attachmentUrl String?
  taxWithheld   Decimal?      @default(0) @db.Decimal(14, 2)
  bankAccount   BankAccount?  @relation(fields: [bankAccountId], references: [id])
  recordedBy    User?         @relation(fields: [recordedById], references: [id])
  client        Client?       @relation(fields: [clientId], references: [id])
  project       Project?      @relation(fields: [projectId], references: [id])

  @@index([date])
  @@index([clientId])
  @@index([projectId])
}

model CreditNote {
  id              String         @id @default(cuid())
  referenceNumber String         @unique
  type            CreditNoteType
  clientId        String
  invoiceId       String?
  amount          Decimal        @db.Decimal(14, 2)
  currency        String         @default("BDT")
  exchangeRate    Decimal?       @default(1) @db.Decimal(10, 4)
  reason          String
  date            DateTime       @db.Date
  status          String         @default("ISSUED")
  createdById     String?
  refundPaymentId String?        @unique
  createdAt       DateTime       @default(now())
  client          Client         @relation(fields: [clientId], references: [id])
  createdBy       User?          @relation(fields: [createdById], references: [id])
  invoice         Invoice?       @relation(fields: [invoiceId], references: [id])
  refundPayment   Payment?       @relation("RefundPayment", fields: [refundPaymentId], references: [id])

  @@index([clientId])
  @@index([date])
}

model JournalEntry {
  id              String             @id @default(cuid())
  entryType       String
  reference       String
  entryDate       DateTime           @db.Date
  sourceId        String?
  notes           String?
  reversedEntryId String?            @unique
  createdById     String?
  createdAt       DateTime           @default(now())
  createdBy       User?              @relation(fields: [createdById], references: [id])
  reversedEntry   JournalEntry?      @relation("EntryReversal", fields: [reversedEntryId], references: [id])
  reversedEntries JournalEntry?      @relation("EntryReversal")
  lines           JournalEntryLine[]

  @@index([entryType])
  @@index([entryDate])
  @@index([sourceId])
}

model JournalEntryLine {
  id        String       @id @default(cuid())
  entryId   String
  accountId String
  debit     Decimal      @default(0) @db.Decimal(14, 2)
  credit    Decimal      @default(0) @db.Decimal(14, 2)
  memo      String?
  account   Account      @relation(fields: [accountId], references: [id])
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([entryId])
}

model CreditBalance {
  id                 String   @id @default(cuid())
  clientId           String
  amount             Decimal  @db.Decimal(14, 2)
  currency           String   @default("BDT")
  source             String
  appliedToInvoiceId String?
  createdAt          DateTime @default(now())
  client             Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Budget {
  id           String      @id @default(cuid())
  scopeType    BudgetScope
  projectId    String?
  departmentId String?
  category     String?
  budgetAmount Decimal     @db.Decimal(14, 2)
  currency     String      @default("BDT")
  periodStart  DateTime?
  periodEnd    DateTime?
  project      Project?    @relation(fields: [projectId], references: [id])
}

model BankAccount {
  id                    String                 @id @default(cuid())
  accountName           String
  accountType           BankAccountType
  currency              String                 @default("BDT")
  currentBalance        Decimal                @default(0) @db.Decimal(14, 2)
  /// Print details. A BANK account stores bankName + branch + routingNumber;
  /// an MFS wallet (bKash/Nagad/Rocket/Upay) stores accountNumber as the
  /// mobile number. Kept nullable so existing rows stay valid.
  accountHolder         String?
  bankName              String?
  accountNumber         String?
  branch                String?
  routingNumber         String?
  /// Show this account in the invoice "Pay via" box.
  showOnInvoice         Boolean                @default(true)
  /// The account highlighted first on invoices and prefilled in forms.
  isPrimary             Boolean                @default(false)
  isActive              Boolean                @default(true)
  expenses              Expense[]
  manualIncome          ManualIncome[]
  payments              Payment[]
  reconciliationRecords ReconciliationRecord[]
  statementLines        BankStatementLine[]
}

model ReconciliationRecord {
  id                 String      @id @default(cuid())
  bankAccountId      String
  statementDate      DateTime    @db.Date
  statementAmount    Decimal     @db.Decimal(14, 2)
  statementReference String?
  matchedPaymentId   String?
  matchStatus        MatchStatus @default(UNMATCHED)
  bankAccount        BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
}

model FinanceAuditLog {
  id            String   @id @default(cuid())
  entityType    String
  entityId      String
  action        String
  performedById String?
  beforeValue   Json?
  afterValue    Json?
  timestamp     DateTime @default(now())
  performedBy   User?    @relation(fields: [performedById], references: [id])

  @@index([timestamp])
  @@index([entityType, entityId])
}

// ─── Accounting controls ──────────────────────────────────────────────

/// A closed/locked accounting period. Nothing may be posted inside a CLOSED or
/// LOCKED window; the ledger checks this on every journal entry.
model FiscalPeriod {
  id         String       @id @default(cuid())
  name       String
  periodType PeriodType   @default(MONTH)
  startDate  DateTime     @db.Date
  endDate    DateTime     @db.Date
  status     PeriodStatus @default(OPEN)
  closedAt   DateTime?
  closedById String?
  lockedAt   DateTime?
  lockedById String?
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([startDate, endDate])
  @@index([status])
  @@index([startDate, endDate])
}

/// Manual journal entry. Posted to the GL with entryType MANUAL and
/// sourceId = ManualJournal.id, so it can be drift-checked like any document.
model ManualJournal {
  id            String              @id @default(cuid())
  reference     String              @unique
  entryDate     DateTime            @db.Date
  memo          String?
  /// DRAFT | POSTED | VOID
  status        String              @default("DRAFT")
  attachmentUrl String?
  createdById   String?
  postedAt      DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  lines         ManualJournalLine[]

  @@index([entryDate])
  @@index([status])
}

model ManualJournalLine {
  id        String        @id @default(cuid())
  journalId String
  accountId String
  debit     Decimal       @default(0) @db.Decimal(14, 2)
  credit    Decimal       @default(0) @db.Decimal(14, 2)
  memo      String?
  journal   ManualJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([journalId])
  @@index([accountId])
}

/// Fixed asset register. Depreciation posts Dr Depreciation Expense /
/// Cr Accumulated Depreciation once per asset per period.
model FixedAsset {
  id                      String            @id @default(cuid())
  name                    String
  category                String            @default("EQUIPMENT")
  purchaseDate            DateTime          @db.Date
  cost                    Decimal           @db.Decimal(14, 2)
  salvageValue            Decimal           @default(0) @db.Decimal(14, 2)
  usefulLifeMonths        Int
  /// STRAIGHT_LINE only for now; kept as a string so declining-balance can be added.
  method                  String            @default("STRAIGHT_LINE")
  accumulatedDepreciation Decimal           @default(0) @db.Decimal(14, 2)
  /// ACTIVE | DISPOSED
  status                  String            @default("ACTIVE")
  disposedAt              DateTime?         @db.Date
  disposalProceeds        Decimal?          @db.Decimal(14, 2)
  serialNumber            String?
  notes                   String?
  createdById             String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  runs                    DepreciationRun[]

  @@index([status])
}

model DepreciationRun {
  id          String     @id @default(cuid())
  assetId     String
  period      String
  amount      Decimal    @db.Decimal(14, 2)
  journalId   String?
  createdById String?
  createdAt   DateTime   @default(now())
  asset       FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, period])
  @@index([period])
}

/// One imported bank-statement row, matched (or not) to a payment/expense.
model BankStatementLine {
  id                     String      @id @default(cuid())
  bankAccountId          String
  bankAccount            BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  statementDate          DateTime    @db.Date
  description            String
  reference              String?
  /// Money in.
  debit                  Decimal     @default(0) @db.Decimal(14, 2)
  /// Money out.
  credit                 Decimal     @default(0) @db.Decimal(14, 2)
  matchedPaymentId       String?
  matchedExpenseId       String?
  matchedVendorPaymentId String?
  /// UNMATCHED | MATCHED | IGNORED
  status                 String      @default("UNMATCHED")
  note                   String?
  importedById           String?
  importedAt             DateTime    @default(now())

  @@index([bankAccountId, statementDate])
  @@index([status])
}

/// Audit trail for period-end FX revaluation runs.
model FxRevaluation {
  id           String   @id @default(cuid())
  asOfDate     DateTime @db.Date
  currency     String
  rate         Decimal  @db.Decimal(10, 4)
  gain         Decimal  @default(0) @db.Decimal(14, 2)
  loss         Decimal  @default(0) @db.Decimal(14, 2)
  invoiceCount Int      @default(0)
  journalId    String?
  createdById  String?
  createdAt    DateTime @default(now())

  @@index([asOfDate])
}

enum PeriodType {
  MONTH
  QUARTER
  YEAR
}

enum PeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

/// Advance billing that must be recognised over several periods.
/// Recognising the whole invoice on issue date overstates the month it was
/// billed and understates the months the work actually happened in.
model DeferredRevenue {
  id               String              @id @default(cuid())
  invoiceId        String              @unique
  totalAmount      Decimal             @db.Decimal(14, 2)
  recognizedAmount Decimal             @default(0) @db.Decimal(14, 2)
  startDate        DateTime            @db.Date
  periods          Int
  monthlyAmount    Decimal             @db.Decimal(14, 2)
  /// ACTIVE | COMPLETED | CANCELLED
  status           String              @default("ACTIVE")
  createdById      String?
  createdAt        DateTime            @default(now())
  runs             DeferredRevenueRun[]

  @@index([status])
}

model DeferredRevenueRun {
  id         String         @id @default(cuid())
  scheduleId String
  period     String
  amount     Decimal        @db.Decimal(14, 2)
  journalId  String?
  createdAt  DateTime       @default(now())
  schedule   DeferredRevenue @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, period])
  @@index([period])
}

/// A period-end bad-debt provision computed from AR ageing.
model ProvisionRun {
  id          String   @id @default(cuid())
  asOfDate    DateTime @db.Date
  basis       String   @default("AGING")
  rate        Decimal  @db.Decimal(5, 2)
  amount      Decimal  @db.Decimal(14, 2)
  journalId   String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([asOfDate])
}

/// Petty-cash register: small cash movements that never go through a bank.
model PettyCashEntry {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  description String
  /// IN | OUT
  direction   String
  amount      Decimal  @db.Decimal(14, 2)
  category    String?
  receiptUrl  String?
  journalId   String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([date])
}

model ContentPost {
  id              String                @id @default(cuid())
  title           String
  content         String                @default("")
  platforms       Json                  @default("[]")
  /// Deprecated string mirror kept for older readers. Always written together
  /// with `scheduledAt` (which is the queryable source of truth).
  scheduledDate   String                @default("")
  scheduledTime   String                @default("10:00")
  scheduledAt     DateTime?
  timeZone        String                @default("Asia/Dhaka")
  status          ContentPostStatus     @default(DRAFT)
  publishStatus   PublishStatus         @default(DRAFT)
  approvalStatus  ContentApprovalStatus @default(NONE)
  clientId        String?
  projectId       String?
  campaignId      String?
  pillarId        String?
  assigneeId      String?
  reviewerId      String?
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  publishedAt     DateTime?
  externalUrl     String?
  externalPostId  String?
  format          ContentFormat         @default(STATIC)
  contentType     String?
  accountIds      String[]              @default([])
  hashtags        String[]              @default([])
  linkUrl         String?
  firstComment    String?
  altText         String?
  notesInternal   String?
  assetUrls       Json                  @default("[]")
  hasImage        Boolean               @default(false)
  hasVideo        Boolean               @default(false)
  isRecurring     Boolean               @default(false)
  recurrenceRule  String?
  archivedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  client          Client?               @relation(fields: [clientId], references: [id])
  project         Project?              @relation(fields: [projectId], references: [id])
  campaign        Campaign?             @relation(fields: [campaignId], references: [id])
  pillar          ContentPillar?        @relation(fields: [pillarId], references: [id])
  assignee        Employee?             @relation("PostAssignee", fields: [assigneeId], references: [id])
  reviewer        Employee?             @relation("PostReviewer", fields: [reviewerId], references: [id])
  approvedBy      User?                 @relation("PostApprovedBy", fields: [approvedById], references: [id])
  metrics         ContentMetric?

  @@index([status])
  @@index([scheduledDate])
  @@index([scheduledAt])
  @@index([clientId, scheduledAt])
  @@index([projectId, scheduledAt])
  @@index([campaignId])
  @@index([approvalStatus])
}

model CalendarEvent {
  id               String            @id @default(cuid())
  title            String
  type             CalendarEventType @default(MEETING)
  /// Day key (YYYY-MM-DD, Asia/Dhaka). Kept as a string because the whole
  /// app already speaks in day keys and dashboard queries compare strings.
  date             String
  endDate          String?
  startTime        String?
  endTime          String?
  allDay           Boolean           @default(false)
  timeZone         String            @default("Asia/Dhaka")
  location         String?
  meetingUrl       String?
  notes            String?
  attendeeIds      String[]          @default([])
  clientContactIds String[]          @default([])
  reminderMinutes  Int[]             @default([1440, 60])
  outcome          EventOutcome      @default(PENDING)
  visibility       EventVisibility   @default(INTERNAL)
  createdById      String?
  clientId         String?
  projectId        String?
  campaignId       String?
  taskId           String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  client           Client?           @relation(fields: [clientId], references: [id])
  project          Project?          @relation(fields: [projectId], references: [id])
  campaign         Campaign?         @relation(fields: [campaignId], references: [id])

  @@index([date])
  @@index([clientId, date])
  @@index([projectId])
}

model DailyTarget {
  id         String   @id @default(cuid())
  title      String
  target     Float    @default(1)
  current    Float    @default(0)
  unit       String   @default("")
  category   String   @default("sales")
  period     String
  periodType String   @default("MONTH")
  clientId   String?
  createdAt  DateTime @default(now())
  client     Client?  @relation(fields: [clientId], references: [id])

  @@index([period])
  @@index([clientId])
}

// ── Calendar: campaigns & ad planning ─────────────────────────────────
model Campaign {
