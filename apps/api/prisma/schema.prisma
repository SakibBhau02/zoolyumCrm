generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id                String   @id @default(cuid())
  name              String   @unique
  description       String?
  modulePermissions Json
  createdAt         DateTime @default(now())
  users             User[]
}

model User {
  id                           String                   @id @default(cuid())
  name                         String
  email                        String                   @unique
  passwordHash                 String
  roleId                       String
  employeeId                   String?                  @unique
  isActive                     Boolean                  @default(true)
  createdAt                    DateTime                 @default(now())
  lastLoginAt                  DateTime?
  attendanceCorrections        Attendance[]
  attendanceCorrectionLogs     AttendanceCorrection[]
  clients                      Client[]
  clientComments               ClientComment[]
  clientDocuments              ClientDocument[]
  dismissedCorrelationInsights CorrelationInsight[]
  creditNotes                  CreditNote[]
  approvedExpenses             Expense[]                @relation("ExpenseApproved")
  submittedExpenses            Expense[]                @relation("ExpenseSubmitted")
  financeAuditLogs             FinanceAuditLog[]
  integrations                 Integration[]
  invoices                     Invoice[]
  journalEntries               JournalEntry[]
  leads                        Lead[]
  leadActivities               LeadActivity[]
  leadAttachments              LeadAttachment[]
  leadMeetings                 LeadMeeting[]
  leadNotes                    LeadNote[]
  leaveApprovals               LeaveRequest[]           @relation("LeaveApproval")
  manualIncome                 ManualIncome[]
  notifications                Notification[]
  notificationPreferences      NotificationPreference[]
  checklistItems               EmployeeChecklistItem[]
  telegramLink                 TelegramLink?
  webauthnCredentials          WebAuthnCredential[]
  payments                     Payment[]
  performanceReviews           PerformanceReview[]
  approvedPosts                ContentPost[]            @relation("PostApprovedBy")
  calendarComments             CalendarComment[]        @relation("CalendarCommentAuthor")
  dailyLogs                    DailyLog[]               @relation("DailyLogAuthor")
  savedCalendarViews           SavedCalendarView[]      @relation("SavedCalendarViewOwner")
  portalUsers                  PortalUser?              @relation("PortalUserAccount")
  projects                     Project[]
  projectFiles                 ProjectFile[]
  projectReferences            ProjectReference[]
  projectProposalsUpdated      ProjectProposal[]        @relation("ProjectProposalUpdatedBy")
  generatedReports             ProjectReport[]          @relation("ReportGeneratedBy")
  shootsCreated                Shoot[]                  @relation("ShootCreatedBy")
  reportDefinitions            ReportDefinition[]
  savedTaskViews               SavedTaskView[]
  taskComments                 TaskComment[]
  employee                     Employee?                @relation(fields: [employeeId], references: [id])
  role                         Role                     @relation(fields: [roleId], references: [id])
  workdayOverrides             WorkdayOverride[]
  /// Bumped on password change / deactivate / role change so old JWTs stop working.
  tokenVersion                 Int                      @default(0)
  lastLoginIp                  String?
}

/// WebAuthn platform credential (Windows Hello / Touch ID / fingerprint).
/// Used for passwordless staff sign-in and biometric clock in/out.
model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String?
  deviceLabel  String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Integration {
  id             String            @id @default(cuid())
  providerName   String
  type           IntegrationType
  status         IntegrationStatus @default(DISCONNECTED)
  credentialsEnc String?
  connectedById  String?
  connectedAt    DateTime?
  createdAt      DateTime          @default(now())
  connectedBy    User?             @relation(fields: [connectedById], references: [id])
}

/// Telegram bot channel. One row per user/employee that has pressed /start
/// with a valid link code — `chatId` is what the Bot API needs to deliver.
model TelegramLink {
  id         String    @id @default(cuid())
  userId     String?   @unique
  employeeId String?   @unique
  chatId     String    @unique
  username   String?
  firstName  String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([isActive])
}

/// Short-lived one-time code printed in the UI and consumed by `/start <code>`.
/// Codes are single-use (`usedAt`) and expire so a leaked link cannot be replayed.
model TelegramLinkCode {
  code       String    @id
  userId     String?
  employeeId String?
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
}

/// Delivery audit — mirrors WhatsappMessageLog so the Control panel can show
/// what was sent, to whom, and exactly why a send failed.
model TelegramMessageLog {
  id        String   @id @default(cuid())
  chatId    String
  kind      String   @default("notification")
  title     String?
  body      String?
  status    String   @default("queued")
  messageId String?
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

/// Onboarding / offboarding run for one employee. Items are rows (not a JSON
/// blob) so progress, ownership and "who ticked it" stay queryable and the
/// weekly nudge can find stale steps without parsing JSON.
model EmployeeChecklist {
  id          String                  @id @default(cuid())
  employeeId  String
  kind        String                  @default("ONBOARDING") // ONBOARDING | OFFBOARDING
  status      String                  @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED
  dueDate     DateTime?
  startedAt   DateTime                @default(now())
  completedAt DateTime?
  notes       String?
  employee    Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  items       EmployeeChecklistItem[]

  @@unique([employeeId, kind])
  @@index([status])
}

model EmployeeChecklistItem {
  id          String            @id @default(cuid())
  checklistId String
  label       String
  owner       String? // HR | IT | Manager | Finance
  done        Boolean           @default(false)
  doneAt      DateTime?
  doneById    String?
  sortOrder   Int               @default(0)
  checklist   EmployeeChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  doneBy      User?             @relation(fields: [doneById], references: [id])

  @@index([checklistId, sortOrder])
}

/// Company asset register — laptops, cameras, phones, licences.
model Asset {
  id           String    @id @default(cuid())
  tag          String    @unique
  name         String
  category     String    @default("Laptop")
  serialNumber String?
  status       String    @default("AVAILABLE") // AVAILABLE | ASSIGNED | REPAIR | RETIRED
  assignedToId String?
  assignedAt   DateTime?
  purchaseDate DateTime?
  value        Decimal?  @db.Decimal(14, 2)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  assignedTo   Employee? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([assignedToId])
}

model WhatsappMessageLog {
  id                String   @id @default(cuid())
  to                String
  templateName      String?
  language          String?  @default("en")
  messageType       String   @default("template")
  params            Json?
  relatedInvoiceId  String?
  relatedEntityType String?
  relatedEntityId   String?
  status            String   @default("queued")
  wamid             String?  @unique
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([relatedInvoiceId])
  @@index([status])
  @@index([createdAt])
}

model WhatsappTemplate {
  id          String   @id @default(cuid())
  name        String
  language    String   @default("en")
  category    String   @default("UTILITY")
  description String?
  variables   String[] @default([])
  bodyPreview String?
  buttons     Json?
  isActive    Boolean  @default(true)
  metaStatus  String?

  @@unique([name, language])
}

model BrandingConfig {
  id                     String   @id @default(cuid())
  logoUrl                String?
  primaryColor           String?
  secondaryColor         String?
  invoiceNumberingFormat String   @default("ZLM-{year}-{seq}")
  updatedAt              DateTime @updatedAt
  appName                String?  @default("Zoolyum OS")
  logoDarkUrl            String?
  logoLightUrl           String?
  /// JPEG XL siblings for the three logos (progressive <picture> sources).
  logoJxlUrl             String?
  logoDarkJxlUrl         String?
  logoLightJxlUrl        String?
  address                String?
  authorizedSignerName   String?
  authorizedSignerTitle  String?
  city                   String?
  country                String?
  defaultCurrency        String?  @default("BDT")
  defaultNotes           String?
  defaultPaymentDetails  Json?
  defaultTerms           String?
  email                  String?
  phone                  String?
  signatureImageUrl      String?
  tagline                String?
  taxId                  String?
  website                String?
}

model SystemAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  beforeValue Json?
  afterValue  Json?
  timestamp   DateTime @default(now())
}

model Notification {
  id           String      @id @default(cuid())
  // Exactly one of userId / portalUserId is set: staff inbox vs client portal inbox.
  userId       String?
  portalUserId String?
  type         String
  title        String
  message      String
  isRead       Boolean     @default(false)
  link         String?
  createdAt    DateTime    @default(now())
  user         User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  portalUser   PortalUser? @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([portalUserId, isRead])
  @@index([portalUserId, createdAt])
}

model NotificationPreference {
  id      String  @id @default(cuid())
  userId  String
  type    String
  channel String
  enabled Boolean @default(true)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, channel])
}

model Settings {
  id                  String   @id @default("default")
  companyProfile      Json     @default("{}")
  regional            Json     @default("{}")
  invoiceTemplate     Json     @default("{}")
  financeConfig       Json     @default("{}")
  pipelineStages      Json     @default("[]")
  leadCategories      Json     @default("[]")
  clientTiers         Json     @default("[]")
  healthScoreWeights  Json     @default("[]")
  /**
   * Scoring engine config: client + project factors, bands, override rules. See scoring.service.ts.
   */
  scoringConfig       Json     @default("{}")
  /**
   * Lead intake rules (validation, duplicates, routing, scoring, SLA). See lead-rules.service.
   */
  leadRules           Json     @default("{}")
  taskStatuses        Json     @default("[]")
  taskAutomation      Boolean  @default(true)
  /**
   * Department → allowed task types. `[]` = no restriction (see TeamService).
   */
  departmentTaskTypes Json     @default("[]")
  notifications       Json     @default("[]")
  integrations        Json     @default("[]")
  emailTemplates      Json     @default("[]")
  appearance          Json     @default("{}")
  /// Admin-only config: security policy, system flags, SMTP. Kept out of the
  /// public settings sections so it can never be written by a normal save.
  adminConfig         Json     @default("{}")
  updatedAt           DateTime @updatedAt
}

model LeadCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())
  leads     Lead[]
}

model PipelineStage {
  id      String @id @default(cuid())
  name    String @unique
  order   Int    @unique
  slaDays Int    @default(5)
}

model LeadMeeting {
  id            String                @id @default(cuid())
  leadId        String
  title         String
  type          MeetingType           @default(VIDEO_CALL)
  scheduledAt   DateTime
  durationMins  Int                   @default(30)
  meetingLink   String?
  location      String?
  status        MeetingStatus         @default(SCHEDULED)
  notes         String?
  createdById   String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  attendees     Json?
  attendeeLinks LeadMeetingAttendee[]
  createdBy     User?                 @relation(fields: [createdById], references: [id])
  lead          Lead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

/**
 * One row per employee invited to a lead meeting.
 * `LeadMeeting.attendees` is a loose JSON blob of `{ id, name }` where the id is
 * a *User* id — useless for "how many meetings did this employee attend" because
 * an employee without a login has no User row. This table is the relational
 * source of truth: it keys on Employee and carries the attendance outcome.
 */
model LeadMeetingAttendee {
  id         String      @id @default(cuid())
  meetingId  String
  employeeId String
  status     String      @default("INVITED") // INVITED | ATTENDED | NO_SHOW
  markedAt   DateTime?
  createdAt  DateTime    @default(now())
  meeting    LeadMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([meetingId, employeeId])
  @@index([employeeId])
  @@index([meetingId])
}

model Lead {
  id                String           @id @default(cuid())
  name              String
  company           String?
  contactEmail      String?
  contactPhone      String?
  /**
   * E.164-ish phone used for duplicate matching (+8801XXXXXXXXX).
   */
  phoneNormalized   String?
  /**
   * Rule-engine flags: NO_PHONE, NO_COMPANY, DUPLICATE, STALE, SLA_BREACH, UNASSIGNED.
   */
  qualityFlags      String[]         @default([])
  source            LeadSource       @default(OTHER)
  vertical          Vertical         @default(OTHER)
  stage             LeadStage        @default(NEW)
  leadScore         Int?             @default(0)
  estimatedDealSize Decimal?         @db.Decimal(14, 2)
  currency          String           @default("BDT")
  assignedToId      String?
  convertedClientId String?          @unique
  lastContactedAt   DateTime?
  /**
   * What the lead needs — sector, requirement, budget, timeline. Shown at the top of the lead view.
   */
  description       String?
  notes             String?
  createdAt         DateTime         @default(now())
  priority          LeadPriority     @default(MEDIUM)
  stageEnteredAt    DateTime?        @default(now())
  firstResponseAt   DateTime?
  nextFollowUpAt    DateTime?
  temperature       LeadTemperature  @default(WARM)
  probability       Int              @default(50)
  starred           Boolean          @default(false)
  tags              String[]         @default([])
  website           String?
  pageLink          String?
  uid               String?          @unique
  leadCategoryId    String?
  assignedTo        User?            @relation(fields: [assignedToId], references: [id])
  client            Client?          @relation("ClientFromLead", fields: [convertedClientId], references: [id])
  leadCategory      LeadCategory?    @relation(fields: [leadCategoryId], references: [id])
  activities        LeadActivity[]
  attachments       LeadAttachment[]
  followUps         LeadFollowUp[]
  meetings          LeadMeeting[]
  notesList         LeadNote[]
  lostReason        LostReason?
  projects          Project[]        @relation("ProjectSourceLead")
  proposals         Proposal[]

  @@index([stage])
  @@index([assignedToId])
  @@index([leadCategoryId])
  @@index([leadScore])
  @@index([createdAt])
  @@index([nextFollowUpAt])
  @@index([temperature])
  @@index([priority])
  @@index([stage, createdAt])
  @@index([phoneNormalized])
  // Trigram indexes serve the `contains` search on /pulse/leads (audit PERF-05).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([company(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([contactEmail(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([contactPhone(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([uid(ops: raw("gin_trgm_ops"))], type: Gin)
}

model LeadNote {
  id          String   @id @default(cuid())
  leadId      String
  content     String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation(fields: [createdById], references: [id])
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([createdById])
}

model LeadAttachment {
  id           String   @id @default(cuid())
  leadId       String
  title        String?
  fileUrl      String
  filename     String
  mimeType     String?
  sizeBytes    Int?
  uploadedById String?
  createdAt    DateTime @default(now())
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])

  @@index([leadId])
  @@index([uploadedById])
}

model LeadFollowUp {
  id        String         @id @default(cuid())
  leadId    String
  date      DateTime
  notes     String         @default("")
  status    FollowUpStatus @default(SCHEDULED)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  lead      Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, status, date])
}

model LeadActivity {
  id         String       @id @default(cuid())
  leadId     String
  type       ActivityType
  content    String
  loggedById String?
  loggedAt   DateTime     @default(now())
  changes    Json?
  lead       Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  loggedBy   User?        @relation(fields: [loggedById], references: [id])

  @@index([leadId])
  @@index([loggedAt])
}

model Proposal {
  id               String         @id @default(cuid())
  leadId           String
  versionNumber    Int            @default(1)
  fileUrl          String?
  portalLink       String?
  sentDate         DateTime?
  viewed           Boolean        @default(false)
  viewDurationSecs Int?           @default(0)
  status           ProposalStatus @default(DRAFT)
  createdAt        DateTime       @default(now())
  project          Project?       @relation("ProjectSourceProposal")
  lead             Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model LostReason {
  id             String             @id @default(cuid())
  leadId         String             @unique
  reasonCategory LostReasonCategory
  notes          String?
  recordedAt     DateTime           @default(now())
  lead           Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Client {
  id                        String                  @id @default(cuid())
  companyName               String
  industryVertical          Vertical                @default(OTHER)
  accountOwnerId            String?
  healthScore               Int?                    @default(75)
  healthLevel               HealthLevel             @default(GREEN)
  healthDriver              String?
  /// Factor-level breakdown of the last score (see scoring.service.ts).
  healthBreakdown           Json?
  /// When the score was last computed by the engine.
  healthComputedAt          DateTime?
  /// Explicit segment profile id from the scoring config. Null = derive from billing cycle.
  scoreProfile              String?
  billingCycleType          BillingCycleType        @default(MONTHLY_RETAINER)
  currencyPreference        String                  @default("BDT")
  contractStartDate         DateTime?
  renewalDate               DateTime?
  notes                     String?
  createdAt                 DateTime                @default(now())
  category                  ClientCategory          @default(ACTIVE)
  autoGenerateInvoice       Boolean                 @default(true)
  billingDayOfMonth         Int?
  lastAutoInvoiceCycle      String?
  monthlyAmount             Decimal?                @db.Decimal(14, 2)
  monthlyServiceDescription String?
  paymentDueDays            Int?                    @default(15)
  nextRetainerDate          DateTime?               @db.Date
  retainerInterval          String?                 @default("MONTHLY")
  /// Brand colour used for this client's chips across the Calendar.
  calendarColor             String?
  /// Company logo: universal WebP + optional JPEG XL sibling (see image-pipeline).
  logoUrl                   String?
  logoJxlUrl                String?
  /// Monthly posting target per platform, e.g. { "INSTAGRAM": 16 }.
  postingTargets            Json?
  /// Hard cap on outstanding receivables. Null = no limit.
  creditLimit               Decimal?                @db.Decimal(14, 2)
  /// When true, new invoices for this client are blocked until the balance is cleared.
  creditHold                Boolean                 @default(false)
  adAccounts                AdAccount[]
  adInsights                AdInsight[]
  alertRules                AlertRule[]
  calendarEvents            CalendarEvent[]
  contentPosts              ContentPost[]
  platformAccounts          ClientPlatformAccount[]
  campaigns                 Campaign[]
  adFlights                 AdFlight[]
  pillars                   ContentPillar[]
  plans                     CalendarPlan[]
  dayLogs                   DailyLog[]
  shareLinks                CalendarShareLink[]
  periodTargets             DailyTarget[]
  churnFlags                ChurnRiskFlag[]
  accountOwner              User?                   @relation(fields: [accountOwnerId], references: [id])
  contacts                  ClientContact[]
  documents                 ClientDocument[]
  healthLogs                ClientHealthLog[]
  creditBalances            CreditBalance[]
  creditNotes               CreditNote[]
  expense                   Expense[]
  invoices                  Invoice[]
  lead                      Lead?                   @relation("ClientFromLead")
  projects                  Project[]
  clientComments            ClientComment[]
  reportDefinitions         ReportDefinition[]
  vendorEngagements         VendorEngagement[]
  dollarSales               DollarSale[]
  manualIncome              ManualIncome[]

  @@index([accountOwnerId])
  @@index([category])
  // Hot-path indexes (production audit 2026-11)
  @@index([healthScore])
  @@index([healthLevel])
  @@index([industryVertical])
}

model ClientContact {
  id                  String      @id @default(cuid())
  clientId            String
  name                String
  roleTitle           String?
  email               String?     @unique
  phone               String?
  isPrimary           Boolean     @default(false)
  portalAccessEnabled Boolean     @default(false)
  lastPortalLogin     DateTime?
  whatsappOptIn       Boolean     @default(true)
  client              Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  portalUser          PortalUser?

  // Hot-path indexes (production audit 2026-11)
  @@index([clientId])
}

model ClientDocument {
  id           String        @id @default(cuid())
  clientId     String
  type         ClientDocType
  fileUrl      String
  uploadedById String?
  isEncrypted  Boolean       @default(false)
  uploadedAt   DateTime      @default(now())
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uploadedBy   User?         @relation(fields: [uploadedById], references: [id])
}

model ClientHealthLog {
  id            String       @id @default(cuid())
  clientId      String
  score         Int
  level         HealthLevel?
  driverSummary String?
  /// Per-factor contributions captured at computation time.
  breakdown     Json?
  recordedAt    DateTime     @default(now())
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ChurnRiskFlag {
  id             String    @id @default(cuid())
  clientId       String
  riskLevel      RiskLevel
  matchedPattern String?
  flaggedAt      DateTime  @default(now())
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Hot-path indexes (production audit 2026-11)
  @@index([flaggedAt, clientId])
}

model ProjectTemplate {
  id                    String    @id @default(cuid())
  name                  String
  description           String?
  benchmarkDurationDays Int?
  benchmarkHours        Int?
  defaultTaskList       Json?
  projects              Project[]
}

model Project {
  id                   String               @id @default(cuid())
  clientId             String
  name                 String
  type                 ProjectType          @default(FIXED)
  templateId           String?
  startDate            DateTime
  targetEndDate        DateTime?
  status               ProjectStatus        @default(ACTIVE)
  healthStatus         HealthStatus         @default(ON_TRACK)
  riskScore            Int?                 @default(0)
  riskDriver           String?
  /// PM's 1-5 forward-looking confidence, the only subjective input in the score.
  confidenceScore      Int?
  /// Manual override of the computed health level. When set it wins over the engine.
  healthStatusOverride HealthStatus?
  healthOverrideReason String?
  healthComputedAt     DateTime?
  healthBreakdown      Json?
  budgetAmount         Decimal?             @db.Decimal(14, 2)
  currency             String               @default("BDT")
  assignedPmId         String?
  createdAt            DateTime             @default(now())
  sourceLeadId         String?
  sourceProposalId     String?              @unique
  uid                  String?              @unique
  category             String?              @default("")
  priority             String?              @default("MEDIUM")
  progress             Int                  @default(0)
  spentAmount          Decimal?             @db.Decimal(14, 2)
  team                 String[]             @default([])
  billingType          BillingCycle         @default(ONE_TIME)
  recurringInterval    String?
  nextBillingDate      DateTime?
  monthlyRate          Decimal?             @db.Decimal(14, 2)
  totalBilled          Decimal?             @db.Decimal(14, 2)
  paymentStatus        String               @default("PENDING")
  briefLink            String?
  driveLink            String?
  researchLink         String?
  description          String?
  amount               Decimal?             @db.Decimal(14, 2)
  projectLink          String?
  websiteUrl           String?
  socialLinks          Json?
  nextReportDate       DateTime?
  reportFrequency      String?
  reportMode           String               @default("MANUAL")
  /// Project logo (WebP + optional JPEG XL sibling).
  logoUrl              String?
  logoJxlUrl           String?
  budgets              Budget[]
  calendarEvents       CalendarEvent[]
  comments             ClientComment[]
  contentPosts         ContentPost[]
  expenses             Expense[]
  invoices             Invoice[]
  milestones           Milestone[]
  assignedPm           User?                @relation(fields: [assignedPmId], references: [id])
  client               Client               @relation(fields: [clientId], references: [id])
  sourceLead           Lead?                @relation("ProjectSourceLead", fields: [sourceLeadId], references: [id])
  sourceProposal       Proposal?            @relation("ProjectSourceProposal", fields: [sourceProposalId], references: [id])
  template             ProjectTemplate?     @relation(fields: [templateId], references: [id])
  deliverables         ProjectDeliverable[]
  shoots               Shoot[]
  files                ProjectFile[]
  /// The one final proposal per project (PDF and/or shared link).
  proposal             ProjectProposal?
  references           ProjectReference[]
  reports              ProjectReport[]
  riskLogs             ProjectRiskLog[]
  sprints              Sprint[]
  tasks                Task[]
  campaigns            Campaign[]
  adFlights            AdFlight[]
  plans                CalendarPlan[]
  vendorEngagements    VendorEngagement[]
  manualIncome         ManualIncome[]

  @@index([clientId])
  @@index([assignedPmId])
  // Hot-path indexes (production audit 2026-11)
  @@index([status, healthStatus, createdAt])
  @@index([reportMode, nextReportDate])
}

/// The project's single final proposal: a PDF and/or a shared link plus the
/// written commercial summary (amount, scope, what shipped). One per project —
/// the unique projectId is what enforces the limit.
model ProjectProposal {
  id          String    @id @default(cuid())
  projectId   String    @unique
  title       String    @default("Final proposal")
  fileUrl     String?
  fileName    String?
  link        String?
  notes       String?
  amount      Decimal?  @db.Decimal(14, 2)
  status      String    @default("DRAFT")
  sentDate    DateTime?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedBy   User?     @relation("ProjectProposalUpdatedBy", fields: [updatedById], references: [id])

  @@index([updatedById])
}

model ProjectReference {
  id           String        @id @default(cuid())
  projectId    String
  title        String
  url          String?
  type         ReferenceType @default(OTHER)
  fileUrl      String?
  uploadedById String?
  createdAt    DateTime      @default(now())
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy   User?         @relation(fields: [uploadedById], references: [id])

  @@index([projectId])
}

model Milestone {
  id            String          @id @default(cuid())
  projectId     String
  name          String
  dueDate       DateTime?
  status        MilestoneStatus @default(PENDING)
  clientVisible Boolean         @default(false)
  completedAt   DateTime?
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  files         ProjectFile[]

  @@index([projectId])
}

model ProjectFile {
  id             String             @id @default(cuid())
  projectId      String
  milestoneId    String?
  fileUrl        String
  /// Display metadata captured at upload time (the blob itself is on disk).
  fileName       String?
  size           Int?
  mimeType       String?
  versionNumber  Int                @default(1)
  uploadedById   String?
  approvalStatus FileApprovalStatus @default(PENDING)
  approvedAt     DateTime?
  uploadedAt     DateTime           @default(now())
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone      Milestone?         @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  uploadedBy     User?              @relation(fields: [uploadedById], references: [id])

  @@index([projectId])
  @@index([milestoneId])
}

model ProjectDeliverable {
  id            String            @id @default(cuid())
  projectId     String
  title         String
  description   String?
  sortOrder     Int               @default(0)
  status        DeliverableStatus @default(PENDING)
  /// What kind of asset this is — the split reports group by (8 graphics, 4 videos).
  kind          DeliverableKind?
  /// What the item actually is, e.g. "Eid greeting post — peacock motif".
  topic         String?
  /// Why it exists, e.g. Awareness / Launch / Conversion.
  objective     String?
  campaignId    String?
  /// Dates power the Calendar's deliverable lane.
  startDate     DateTime?         @db.Date
  dueDate       DateTime?         @db.Date
  clientVisible Boolean           @default(false)
  ownerId       String?
  completedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  campaign      Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  tasks         Task[]

  @@index([projectId])
  @@index([dueDate])
  @@index([campaignId])
  @@index([kind])
}

enum DeliverableKind {
  GRAPHIC
  VIDEO
  PHOTO
  COPY
  OTHER
}

/// A production call-sheet: when we shoot, how long, who is coming and what
/// gear travels. Deliberately independent of deliverables — a shoot is a
/// logistics event, a deliverable is a commitment.
model Shoot {
  id              String        @id @default(cuid())
  projectId       String
  campaignId      String?
  title           String
  /// The shoot day. Required: a shoot without a date is not a shoot.
  shootDate       DateTime      @db.Date
  /// Multi-day productions end here; null for a single day.
  endDate         DateTime?     @db.Date
  durationType    ShootDuration @default(FULL_DAY)
  callTime        String?
  wrapTime        String?
  /// Locked dates may only be changed from the shoot editor, never by dragging
  /// the mirrored calendar event.
  isDateLocked    Boolean       @default(false)
  location        String?
  locationUrl     String?
  locationNote    String?
  description     String?
  notes           String?
  /// Free-text gear list — no catalog. "Sony FX3 ×2", "Aputure 300D"…
  equipment       String[]      @default([])
  status          ShootStatus   @default(PLANNED)
  /// The calendar event this shoot owns (one-way sync: shoot → calendar).
  calendarEventId String?       @unique
  createdById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  campaign  Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdBy User?       @relation("ShootCreatedBy", fields: [createdById], references: [id])
  crew      ShootCrew[]

  @@index([projectId, shootDate])
  @@index([campaignId])
  @@index([shootDate])
  @@index([status])
}

enum ShootDuration {
  HALF_DAY
  FULL_DAY
}

enum ShootStatus {
  PLANNED
  CONFIRMED
  IN_PROGRESS
  WRAPPED
  CANCELLED
}

enum ShootCrewRole {
  DOP
  CAMERAMAN
  ASSISTANT_CAMERA
  GAFFER
  GRIP
  SOUND
  ART_DIRECTOR
  STYLIST
  MAKEUP
  PRODUCER
  LINE_PRODUCER
  PHOTOGRAPHER
  DRONE_OPERATOR
  DRIVER
  TALENT
  TEAM_MEMBER
  OTHER
}

enum ShootCrewSource {
  EMPLOYEE
  VENDOR
  EXTERNAL
}

/// One person on the call sheet. `name` is a snapshot so the sheet still reads
/// correctly after the employee or vendor record is deleted.
model ShootCrew {
  id          String          @id @default(cuid())
  shootId     String
  role        ShootCrewRole
  source      ShootCrewSource @default(EMPLOYEE)
  employeeId  String?
  vendorId    String?
  name        String
  phone       String?
  callTime    String?
  isConfirmed Boolean         @default(false)
  fee         Decimal?        @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime        @default(now())

  shoot    Shoot     @relation(fields: [shootId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  vendor   Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([shootId])
  @@index([employeeId])
  @@index([vendorId])
}

model ProjectReport {
  id            String         @id @default(cuid())
  projectId     String
  title         String
  periodStart   DateTime
  periodEnd     DateTime
  status        ReportStatus   @default(DRAFT)
  completed     Json           @default("[]")
  pending       Json           @default("[]")
  billing       Json?
  pmNotes       String?
  /// How the report lays out its sections; every breakdown is still stored.
  groupBy       ReportGrouping @default(CAMPAIGN)
  /// Set when the report is scoped to one campaign.
  campaignId    String?
  campaignLabel String?
  /// Numeric snapshot captured at generation time (never recomputed later).
  summary       Json?
  /// Shoots inside the period, frozen with crew + equipment.
  shoots        Json?
  generatedById String?
  createdAt     DateTime       @default(now())
  sentAt        DateTime?
  generatedBy   User?          @relation("ReportGeneratedBy", fields: [generatedById], references: [id])
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

enum ReportGrouping {
  CAMPAIGN
  KIND
  OWNER
  NONE
}

model ProjectRiskLog {
  id            String   @id @default(cuid())
  projectId     String
  riskScore     Int
  primaryDriver String?
  /// Per-factor contributions captured at computation time.
  breakdown     Json?
  calculatedAt  DateTime @default(now())
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Hot-path indexes (production audit 2026-11)
  @@index([projectId, calculatedAt])
}

model Task {
  id                  String              @id @default(cuid())
  projectId           String?
  title               String
  description         String?
  assignedToId        String?
  priority            Priority            @default(MEDIUM)
  dueDate             DateTime?
  status              TaskStatus          @default(TODO)
  estimatedHours      Decimal?            @db.Decimal(8, 2)
  parentTaskId        String?
  isClientVisible     Boolean             @default(false)
  isRecurring         Boolean             @default(false)
  recurrenceSchedule  String?
  createdAt           DateTime            @default(now())
  tags                String[]            @default([])
  isBlocked           Boolean             @default(false)
  referenceLinks      Json?               @default("[]")
  activityLog         Json?               @default("[]")
  taskType            String              @default("general")
  startDate           DateTime?
  actualHours         Decimal             @default(0) @db.Decimal(8, 2)
  sortOrder           Int                 @default(0)
  archivedAt          DateTime?
  attachments         Json?               @default("[]")
  assignees           Json?               @default("[]")
  customFields        Json?               @default("[]")
  reporterId          String?
  deliverableId       String?
  completedAt         DateTime?
  recurrenceSpawnedAt DateTime?
  sprintId            String?
  assignedAt          DateTime?
  assignedById        String?
  reportDefinitions   ReportDefinition[]
  assignedBy          Employee?           @relation("taskAssigner", fields: [assignedById], references: [id])
  assignedTo          Employee?           @relation(fields: [assignedToId], references: [id])
  deliverable         ProjectDeliverable? @relation(fields: [deliverableId], references: [id])
  project             Project?            @relation(fields: [projectId], references: [id])
  reporter            Employee?           @relation("taskReporter", fields: [reporterId], references: [id])
  sprint              Sprint?             @relation(fields: [sprintId], references: [id])
  checklist           TaskChecklistItem[]
  comments            TaskComment[]
  dependents          TaskDependency[]    @relation("dependsOnTask")
  dependencies        TaskDependency[]    @relation("taskDependsOn")
  timers              TaskTimer[]
  timeLogs            TimeLog[]

  @@index([assignedToId])
  @@index([status])
  @@index([projectId])
  @@index([sprintId])
  // Hot-path indexes (production audit 2026-11)
  @@index([archivedAt, parentTaskId, dueDate])
  @@index([assignedToId, status, dueDate])
  @@index([parentTaskId])
  @@index([completedAt])
}

model TaskChecklistItem {
