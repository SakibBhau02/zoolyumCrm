DATABASE_URL="postgresql://zoolyum:zoolyum@localhost:5544/zoolyum_os?schema=public"
REDIS_URL="redis://localhost:6380"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
PORT=4000

# Required in production: signs file-download URLs. Must differ from JWT_SECRET
# (rotating the session key must not invalidate every shared file link).
FILE_URL_SECRET="replace-with-another-long-random-secret"

# ZKTeco fingerprint devices. Set the shared key the device appends to its
# server URL. ICLOCK_ALLOW_ANONYMOUS=1 is for a local demo only - staging and
# production fail closed when the key is missing.
ICLOCK_DEVICE_KEY=
ICLOCK_ALLOW_ANONYMOUS=0

# Set to 1 when the API runs behind nginx / an ALB so X-Forwarded-For is used
# for rate limiting, the lockout key and lastLoginIp.
TRUST_PROXY=0

# Comma-separated browser origins allowed to call the API (required in production).
CORS_ORIGINS=
